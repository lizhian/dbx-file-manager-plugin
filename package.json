  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "ajv": "^8.17.1",
    "daisyui": "^5.1.10",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
