{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "lib": ["ES2022", "DOM"],
    "esModuleInterop": true, "resolveJsonModule": true, "types": ["vite/client", "vitest/globals"]
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.vue"]
}
