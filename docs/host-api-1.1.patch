@@ -0,0 +1,36 @@
+use serde::{Deserialize, Serialize};
+
+/// The SDK JSON-RPC error, including opaque plugin recovery information.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct PluginRpcError {
+    pub code: i32,
+    pub message: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub data: Option<serde_json::Value>,
+}
+
+impl PluginRpcError {
+    pub fn host(code: &str, message: impl Into<String>) -> Self {
+        Self { code: -32000, message: message.into(), data: Some(serde_json::json!({ "code": code })) }
+    }
+}
+
+impl std::fmt::Display for PluginRpcError {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str(&self.message)
+    }
+}
+
+impl std::error::Error for PluginRpcError {}
+
+impl From<String> for PluginRpcError {
+    fn from(message: String) -> Self {
+        Self::host("host_error", message)
+    }
+}
+
+impl From<serde_json::Error> for PluginRpcError {
+    fn from(error: serde_json::Error) -> Self {
+        Self::host("invalid_response", error.to_string())
+    }
+}
