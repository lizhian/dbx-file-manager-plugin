+import { describe, expect, it } from "vitest";
+import { decodeFilesystemPreview, FILESYSTEM_PREVIEW_BYTES, filesystemCapabilities, filesystemChildUri, filesystemErrorText, mergeFilesystemEntries, mergeFilesystemTransfer } from "./hostFilesystem";
+import type { PluginFilesystemProviderContribution } from "@/types/database";
+
+const provider: PluginFilesystemProviderContribution = { type: "filesystem-provider", id: "files", label: "Files", schemes: ["sample"], capabilities: ["read", "write", "mkdir", "delete", "rename", "copy", "stat", "upload", "download"] };
+
+describe("host filesystem policy and bounded data", () => {
+  it("never infers new capabilities for legacy providers", () => {
+    expect([...filesystemCapabilities(provider, undefined, false, true)]).toEqual(["list", "read", "write", "mkdir", "delete", "rename"]);
+  });
+  it("intersects declarations and negotiation, then enforces read-only and desktop restrictions", () => {
+    expect([...filesystemCapabilities(provider, ["list", "read", "upload", "download", "copy"], true, true)]).toEqual(["list", "read", "download"]);
+    expect([...filesystemCapabilities(provider, ["upload", "download"], false, false)]).toEqual([]);
+    expect([...filesystemCapabilities({ ...provider, capabilities: ["read"] }, ["list", "read", "write"], false, true)]).toEqual(["list", "read"]);
+  });
+  it("rejects path traversal names and encodes URI metacharacters", () => {
+    expect(filesystemChildUri("sample:/folder/", "a #?.txt")).toBe("sample:/folder/a%20%23%3F.txt");
+    for (const name of ["..", ".", "../x", "a/b", "a\\b", "\u0000", "  "]) expect(() => filesystemChildUri("sample:/", name)).toThrow();
+  });
+  it("bounds base64 before allocation and handles empty and binary previews", () => {
+    expect(decodeFilesystemPreview("")).toBe("");
+    expect(decodeFilesystemPreview(btoa("hello"))).toBe("hello");
+    expect(decodeFilesystemPreview(btoa("a\u0000b"))).toBeUndefined();
+    expect(decodeFilesystemPreview(btoa("a\xe2\x82"), true)).toBe("a");
+    expect(() => decodeFilesystemPreview(btoa("x".repeat(FILESYSTEM_PREVIEW_BYTES + 1)))).toThrow("byte limit");
+  });
+  it("deduplicates overlapping pages by URI", () => {
+    const entry = { uri: "sample:/a", name: "a", kind: "file" as const };
+    expect(mergeFilesystemEntries([entry], [{ ...entry, size: 2 }])).toEqual([{ ...entry, size: 2 }]);
+  });
+  it("does not regress bytes or resurrect completed transfers", () => {
+    const running = { transferId: "t", state: "running" as const, bytesTransferred: 10 };
+    expect(mergeFilesystemTransfer(running, { ...running, bytesTransferred: 2 }).bytesTransferred).toBe(10);
+    const completed = { ...running, state: "completed" as const };
+    expect(mergeFilesystemTransfer(completed, running)).toEqual(completed);
+  });
+  it("retains structured backend recovery details", () => {
+    expect(filesystemErrorText({ code: -32000, message: "Copy failed", data: { code: "io_error", recovery: { action: "inspect_destination", destinationMayExist: true } } })).toContain('"destinationMayExist":true');
+  });
+});
