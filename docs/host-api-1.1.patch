index 000000000..91442078d
--- /dev/null
+++ b/apps/desktop/src/lib/plugins/useFilesystemTransfers.ts
@@ -0,0 +1,111 @@
+import { onBeforeUnmount, ref } from "vue";
+import * as api from "@/lib/backend/api";
+import { activeFilesystemTransfer, filesystemErrorText, mergeFilesystemTransfer } from "./hostFilesystem";
+import type { PluginFilesystemTransfer } from "@/types/database";
+
+export function useFilesystemTransfers(context: { pluginId: string; providerId: string; connectionId?: string }, onCompleted: () => void) {
+  const tasks = ref<(PluginFilesystemTransfer & { name?: string; direction?: "upload" | "download" })[]>([]);
+  const error = ref("");
+  const cancelling = ref(new Set<string>());
+  let stopped = false;
+  let polling = false;
+  let started = false;
+  let generation = 0;
+  let unlisten: (() => void) | undefined;
+  let timer: ReturnType<typeof setInterval> | undefined;
+
+  function update(task: PluginFilesystemTransfer, details: { name?: string; direction?: "upload" | "download" } = {}) {
+    if (stopped) return;
+    const index = tasks.value.findIndex((candidate) => candidate.transferId === task.transferId);
+    const previous = tasks.value[index];
+    const merged = { ...previous, ...mergeFilesystemTransfer(previous, task), ...details };
+    if (index < 0) tasks.value.unshift(merged);
+    else tasks.value[index] = merged;
+    if (previous && previous.state !== "completed" && merged.state === "completed") onCompleted();
+  }
+
+  async function refresh() {
+    if (stopped || polling) return;
+    const epoch = generation;
+    const bound = context;
+    polling = true;
+    try {
+      const result = await api.listPluginFilesystemTransfers(bound.pluginId, bound.providerId, bound.connectionId);
+      if (stopped || epoch !== generation) return;
+      for (const task of result.transfers) update(task);
+      // Status also recovers locally known transfers omitted from a bounded list.
+      for (const task of tasks.value.filter(activeFilesystemTransfer)) {
+        const current = await api.getPluginFilesystemTransfer(bound.pluginId, bound.providerId, task.transferId, bound.connectionId);
+        if (stopped || epoch !== generation) return;
+        update(current);
+      }
+      error.value = "";
+    } catch (cause) {
+      if (!stopped && epoch === generation) error.value = filesystemErrorText(cause);
+    } finally {
+      if (epoch === generation) polling = false;
+    }
+  }
+
+  async function start() {
+    if (started || stopped) return;
+    const epoch = generation;
+    const bound = context;
+    started = true;
+    try {
+      const unsubscribe = await api.subscribePluginEvents((event) => {
+        if (epoch !== generation || event.pluginId !== bound.pluginId || event.method !== "filesystem/transfer/progress" || !event.params || typeof event.params !== "object") return;
+        const task = event.params as PluginFilesystemTransfer;
+        // Only accept IDs established by this context's start/list/status commands.
+        if (tasks.value.some((candidate) => candidate.transferId === task.transferId)) void refresh();
+      });
+      if (stopped || epoch !== generation) {
+        unsubscribe();
+        return;
+      }
+      unlisten = unsubscribe;
+    } catch (cause) {
+      if (!stopped && epoch === generation) error.value = filesystemErrorText(cause);
+    }
+    if (stopped || epoch !== generation) return;
+    timer = setInterval(() => void refresh(), 2000);
+    await refresh();
+  }
+
+  async function cancel(transferId: string) {
+    if (stopped || cancelling.value.has(transferId)) return;
+    const epoch = generation;
+    const bound = context;
+    cancelling.value.add(transferId);
+    try {
+      const task = await api.cancelPluginFilesystemTransfer(bound.pluginId, bound.providerId, transferId, bound.connectionId);
+      if (stopped || epoch !== generation) return;
+      update(task);
+      await refresh();
+    } catch (cause) {
+      if (!stopped && epoch === generation) error.value = filesystemErrorText(cause);
+    } finally {
+      if (epoch === generation) cancelling.value.delete(transferId);
+    }
+  }
+
+  function reset(nextContext: typeof context) {
+    generation++;
+    clearInterval(timer);
+    unlisten?.();
+    unlisten = undefined;
+    context = nextContext;
+    started = false;
+    polling = false;
+    tasks.value = [];
+    error.value = "";
+    cancelling.value.clear();
+  }
+
+  onBeforeUnmount(() => {
+    stopped = true;
+    clearInterval(timer);
+    unlisten?.();
+  });
+  return { tasks, error, cancelling, start, refresh, cancel, update, reset };
+}
