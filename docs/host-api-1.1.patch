+
+fn filesystem_query_timeout(config: Option<&ConnectionConfig>) -> Option<Duration> {
+    match config {
+        None => Some(PLUGIN_REQUEST_TIMEOUT),
+        Some(config) => {
+            let seconds = config.effective_query_timeout_secs();
+            (seconds != 0).then(|| Duration::from_secs(seconds))
+        }
+    }
+}
+
+impl AppState {
+    /// User-facing generic RPC uses the same saved-policy gate as dedicated APIs.
+    /// PluginHost's lower-level generic entry point deliberately cannot do this.
+    pub async fn invoke_plugin_generic<T: DeserializeOwned>(
+        &self,
+        plugin_id: &str,
+        method: &str,
+        params: Value,
+        timeout: Option<std::time::Duration>,
+    ) -> Result<T, PluginRpcError> {
+        if !method.starts_with("filesystem/") || method.starts_with("filesystem/transfer") {
+            return self.plugin_host.invoke_typed(plugin_id, method, params, None, timeout).await;
+        }
+        let operation = match method {
+            "filesystem/list" => Some(PluginFilesystemOperation::List),
+            "filesystem/stat" => Some(PluginFilesystemOperation::Stat),
+            "filesystem/read" => Some(PluginFilesystemOperation::Read),
+            "filesystem/write" => Some(PluginFilesystemOperation::Write),
+            "filesystem/createDirectory" => Some(PluginFilesystemOperation::CreateDirectory),
+            "filesystem/delete" => Some(PluginFilesystemOperation::Delete),
+            "filesystem/rename" => Some(PluginFilesystemOperation::Rename),
+            "filesystem/copy" => Some(PluginFilesystemOperation::Copy),
+            "filesystem/capabilities" => None,
+            _ => return Err(PluginRpcError::host("unsupported", "Unknown filesystem method is not allowed")),
+        };
+        let provider_id = required_text(&params, "providerId")?.to_string();
+        let connection_id = match params.get("connectionId").filter(|value| !value.is_null()) {
+            Some(value) => Some(value.as_str().ok_or_else(|| invalid("connectionId must be a string"))?.to_string()),
+            None => None,
+        };
+        match operation {
+            Some(operation) => {
+                self.invoke_plugin_filesystem(plugin_id, &provider_id, connection_id.as_deref(), operation, params)
+                    .await
+            }
+            None => Ok(serde_json::from_value(serde_json::to_value(
+                self.plugin_filesystem_capabilities(plugin_id, &provider_id, connection_id.as_deref()).await?,
+            )?)?),
+        }
+    }
+
+    // Saved configuration is authoritative: caller-provided flags and stale runtime
+    // config must not grant write access or rebind another plugin's connection.
+    async fn plugin_filesystem_context(
+        &self,
+        plugin_id: &str,
+        provider_id: &str,
+        connection_id: Option<&str>,
+        mutation: bool,
+    ) -> Result<PluginFilesystemContext, PluginRpcError> {
+        let provider = self.plugin_host.resolve_filesystem_provider(plugin_id, provider_id)?;
+        let plugin = self.plugins.find_plugin(plugin_id)?.ok_or_else(|| invalid("Plugin is not installed"))?;
+        let saved = match connection_id {
+            Some(id) => {
+                validate_text(id, 256)?;
+                Some(
+                    self.storage
+                        .load_connections()
+                        .await?
+                        .into_iter()
+                        .find(|config| config.id == id)
+                        .ok_or_else(|| invalid("Saved connection not found"))?,
+                )
+            }
+            None => None,
+        };
+        validate_binding(&plugin.manifest, provider_id, saved.as_ref(), mutation)?;
+        Ok(PluginFilesystemContext {
+            provider,
+            timeout: filesystem_query_timeout(saved.as_ref()),
+            read_only: saved.is_some_and(|config| config.read_only),
+        })
+    }
+
+    pub async fn plugin_filesystem_capabilities(
+        &self,
+        plugin_id: &str,
+        provider_id: &str,
+        connection_id: Option<&str>,
+    ) -> Result<PluginFilesystemCapabilities, PluginRpcError> {
+        let PluginFilesystemContext { provider, read_only, timeout } =
+            self.plugin_filesystem_context(plugin_id, provider_id, connection_id, false).await?;
+        self.plugin_host.filesystem_capabilities_typed(plugin_id, &provider, connection_id, read_only, timeout).await
+    }
+
+    pub async fn invoke_plugin_filesystem<T: DeserializeOwned>(
+        &self,
+        plugin_id: &str,
+        provider_id: &str,
+        connection_id: Option<&str>,
+        operation: PluginFilesystemOperation,
+        params: Value,
+    ) -> Result<T, PluginRpcError> {
+        let PluginFilesystemContext { provider, read_only, mut timeout } = self
+            .plugin_filesystem_context(plugin_id, provider_id, connection_id, is_mutation(operation.capability()))
+            .await?;
+        let mut params = scoped_params(provider_id, connection_id, params)?;
+        prepare_remote_request(&provider, operation, &mut params)?;
+        let capabilities = self
+            .plugin_host
+            .filesystem_capabilities_typed(plugin_id, &provider, connection_id, read_only, timeout)
+            .await?;
+        require_capability(&capabilities, operation.capability())?;
+        if is_mutation(operation.capability()) {
+            timeout = self.plugin_filesystem_context(plugin_id, provider_id, connection_id, true).await?.timeout;
+        }
+        let result: Value =
+            self.plugin_host.invoke_trusted_typed(plugin_id, operation.method(), params.clone(), None, timeout).await?;
+        match operation {
+            PluginFilesystemOperation::List => validate_list_result(
+                &provider,
+                &serde_json::from_value(result.clone())?,
+                params["limit"].as_u64().unwrap() as u32,
+            )?,
+            PluginFilesystemOperation::Stat => validate_entry(&provider, &serde_json::from_value(result.clone())?)?,
+            PluginFilesystemOperation::Read => {
+                validate_read_result(&serde_json::from_value(result.clone())?, params["maxBytes"].as_u64().unwrap())?
+            }
+            _ => validate_mutation_result(&provider, &serde_json::from_value(result.clone())?)?,
+        }
+        Ok(serde_json::from_value(result)?)
+    }
+
+    /// Native paths are a desktop-host API, never a generic invoke or HTTP API.
+    /// The trusted caller must obtain localPath from its native file picker.
+    pub async fn invoke_plugin_filesystem_transfer<T: DeserializeOwned>(
+        &self,
+        plugin_id: &str,
+        provider_id: &str,
+        connection_id: &str,
+        operation: PluginFilesystemTransferOperation,
+        params: Value,
+    ) -> Result<T, PluginRpcError> {
+        let PluginFilesystemContext { provider, read_only, mut timeout } = self
+            .plugin_filesystem_context(
+                plugin_id,
+                provider_id,
+                Some(connection_id),
+                matches!(operation, PluginFilesystemTransferOperation::Upload),
+            )
+            .await?;
+        let mut params = scoped_params(provider_id, Some(connection_id), params)?;
+        match operation {
+            PluginFilesystemTransferOperation::Upload | PluginFilesystemTransferOperation::Download => {
+                let uri = resolve_filesystem_uri(&provider, Some(required_text(&params, "uri")?))?;
+                params["uri"] = json!(uri);
+                validate_local_path(
+                    required_text(&params, "localPath")?,
+                    matches!(operation, PluginFilesystemTransferOperation::Upload),
+                )?;
+                normalize_bool(&mut params, "overwrite")?;
+                let capabilities = self
+                    .plugin_host
+                    .filesystem_capabilities_typed(plugin_id, &provider, Some(connection_id), read_only, timeout)
+                    .await?;
+                require_capability(
+                    &capabilities,
+                    if matches!(operation, PluginFilesystemTransferOperation::Upload) {
+                        Capability::Upload
+                    } else {
+                        Capability::Download
+                    },
+                )?;
+            }
+            PluginFilesystemTransferOperation::Cancel | PluginFilesystemTransferOperation::Status => {
+                validate_text(required_text(&params, "transferId")?, 256)?;
+            }
+            PluginFilesystemTransferOperation::List => {}
+        }
+        if matches!(operation, PluginFilesystemTransferOperation::Upload) {
+            timeout = self.plugin_filesystem_context(plugin_id, provider_id, Some(connection_id), true).await?.timeout;
+        }
+        let result: Value =
+            self.plugin_host.invoke_trusted_typed(plugin_id, operation.method(), params.clone(), None, timeout).await?;
+        // Project onto the public snapshot so backend local paths never leak into
+        // the host's status/list response. The sidecar must scope IDs to the binding.
+        let result = if matches!(operation, PluginFilesystemTransferOperation::List) {
+            let list: PluginFilesystemTransferList = serde_json::from_value(result)?;
+            if list.transfers.len() > 1_000 {
+                return Err(invalid("Too many transfer records"));
+            }
+            for transfer in &list.transfers {
+                validate_transfer_binding(transfer, provider_id, connection_id)?;
+            }
+            serde_json::to_value(list)?
+        } else {
+            let transfer: PluginFilesystemTransfer = serde_json::from_value(result)?;
+            validate_transfer_binding(&transfer, provider_id, connection_id)?;
+            if params.get("transferId").is_some_and(|id| id.as_str() != Some(transfer.transfer_id.as_str())) {
+                return Err(invalid("Transfer response ID does not match request"));
+            }
+            serde_json::to_value(transfer)?
+        };
+        Ok(serde_json::from_value(result)?)
+    }
+}
+
+impl PluginHost {
+    async fn filesystem_capabilities_typed(
+        &self,
+        plugin_id: &str,
+        provider: &PluginFilesystemProviderContribution,
+        connection_id: Option<&str>,
+        read_only: bool,
+        timeout: Option<Duration>,
+    ) -> Result<PluginFilesystemCapabilities, PluginRpcError> {
+        let result = self
+            .invoke_trusted_typed::<Value>(
+                plugin_id,
+                PLUGIN_FILESYSTEM_CAPABILITIES_METHOD,
+                scoped_params(&provider.id, connection_id, json!({}))?,
+                None,
+                timeout,
+            )
+            .await;
+        effective_capabilities(provider, read_only, result)
+    }
+}
+
+fn effective_capabilities(
+    provider: &PluginFilesystemProviderContribution,
+    read_only: bool,
+    result: Result<Value, PluginRpcError>,
+) -> Result<PluginFilesystemCapabilities, PluginRpcError> {
+    let mut ceiling = provider.capabilities.clone();
+    // list was implicit in the original filesystem-provider contract.
+    if !ceiling.contains(&Capability::List) {
+        ceiling.push(Capability::List);
+    }
+    let mut capabilities = match result {
+        Ok(result) => decode_capabilities(result)?,
+        Err(error) if error.code == -32601 => {
+            PluginFilesystemCapabilities { capabilities: ceiling.clone(), details: BTreeMap::new() }
+        }
+        Err(error) => return Err(error),
+    };
+    capabilities
+        .capabilities
+        .retain(|capability| ceiling.contains(capability) && !(read_only && is_mutation(*capability)));
+    for capability in known_capabilities() {
+        if capabilities.details.contains_key(capability.as_str()) {
+            capabilities
+                .details
+                .insert(capability.as_str().to_string(), json!(capabilities.capabilities.contains(&capability)));
+        }
+    }
+    if !capabilities.capabilities.contains(&Capability::Delete) {
+        capabilities.details.insert("recursiveDelete".into(), json!(false));
+    }
+    if !capabilities.capabilities.contains(&Capability::Copy) {
+        capabilities.details.insert("recursiveCopy".into(), json!(false));
+    }
+    if read_only {
+        capabilities.details.insert("readOnly".into(), json!(true));
+    }
+    Ok(capabilities)
+}
+
+fn known_capabilities() -> [Capability; 10] {
+    [
+        Capability::List,
+        Capability::Stat,
+        Capability::Read,
+        Capability::Write,
+        Capability::Mkdir,
+        Capability::Delete,
+        Capability::Rename,
+        Capability::Copy,
+        Capability::Upload,
+        Capability::Download,
+    ]
+}
+
+fn decode_capabilities(value: Value) -> Result<PluginFilesystemCapabilities, PluginRpcError> {
+    let capabilities: PluginFilesystemCapabilities = serde_json::from_value(value)?;
+    for capability in known_capabilities() {
+        if capabilities.details.get(capability.as_str()).is_some_and(|value| !value.is_boolean()) {
+            return Err(invalid("Capability flag must be a boolean"));
+        }
+    }
+    Ok(capabilities)
+}
+
+fn validate_binding(
+    manifest: &PluginManifest,
+    provider_id: &str,
+    config: Option<&ConnectionConfig>,
+    mutation: bool,
+) -> Result<(), PluginRpcError> {
+    let Some(config) = config else {
+        if manifest.contributions.iter().any(|contribution| matches!(contribution,
+            PluginContribution::ConnectionProvider(provider) if provider.filesystem_provider.as_deref() == Some(provider_id))) {
+            return Err(invalid("Filesystem provider requires a saved connection"));
+        }
+        return Ok(());
+    };
+    if config.db_type != DatabaseType::Plugin || config.plugin_id.as_deref() != Some(manifest.id.as_str()) {
+        return Err(invalid("Connection does not belong to this plugin"));
+    }
+    let provider = manifest
+        .connection_provider(
+            config.plugin_connection_provider.as_deref().ok_or_else(|| invalid("Connection provider is missing"))?,
+        )?
+        .ok_or_else(|| invalid("Connection provider is not declared"))?;
+    if provider.filesystem_provider.as_deref() != Some(provider_id)
+        || config.plugin_connection_type.as_deref() != Some(provider.database_type.as_str())
+    {
+        return Err(invalid("Connection is not bound to this filesystem provider"));
+    }
+    if mutation && config.read_only {
+        return Err(PluginRpcError::host("read_only", "Connection has read-only protection enabled"));
+    }
+    Ok(())
+}
+
+fn is_mutation(capability: Capability) -> bool {
+    matches!(
+        capability,
+        Capability::Write
+            | Capability::Mkdir
+            | Capability::Delete
+            | Capability::Rename
+            | Capability::Copy
+            | Capability::Upload
+    )
+}
+
+fn scoped_params(provider_id: &str, connection_id: Option<&str>, params: Value) -> Result<Value, PluginRpcError> {
+    let mut params = params.as_object().cloned().ok_or_else(|| invalid("Filesystem params must be an object"))?;
+    params.insert("providerId".into(), json!(provider_id));
+    if let Some(id) = connection_id {
+        params.insert("connectionId".into(), json!(id));
+    } else {
+        params.remove("connectionId");
+    }
+    Ok(Value::Object(params))
+}
+
+fn prepare_remote_request(
+    provider: &PluginFilesystemProviderContribution,
+    operation: PluginFilesystemOperation,
+    params: &mut Value,
+) -> Result<(), PluginRpcError> {
+    let keys: &[&str] = if matches!(operation, PluginFilesystemOperation::Copy | PluginFilesystemOperation::Rename) {
+        &["sourceUri", "targetUri"]
+    } else {
+        &["uri"]
+    };
+    for key in keys {
+        let requested = if matches!(operation, PluginFilesystemOperation::List) {
+            params[*key].as_str()
+        } else {
+            Some(required_text(params, key)?)
+        };
+        params[*key] = json!(resolve_filesystem_uri(provider, requested)?);
+    }
+    match operation {
+        PluginFilesystemOperation::List => {
+            let limit = optional_u64(params, "limit", DEFAULT_PLUGIN_FILESYSTEM_PAGE_SIZE.into())?
+                .clamp(1, MAX_PLUGIN_FILESYSTEM_PAGE_SIZE.into());
+            params["limit"] = json!(limit);
+            if let Some(cursor) = params.get("cursor").filter(|value| !value.is_null()) {
+                validate_text(cursor.as_str().ok_or_else(|| invalid("Cursor must be a string"))?, 4096)?;
+            }
+        }
+        PluginFilesystemOperation::Read => {
+            params["maxBytes"] = json!(optional_u64(params, "maxBytes", DEFAULT_PLUGIN_FILESYSTEM_PREVIEW_BYTES)?
+                .clamp(1, MAX_PLUGIN_FILESYSTEM_PREVIEW_BYTES));
+        }
+        PluginFilesystemOperation::Write => {
+            validate_inline_write_data(required_text(params, "dataBase64")?)?;
+            normalize_bool(params, "create")?;
+            normalize_bool(params, "overwrite")?;
+            if let Some(etag) = params.get("etag").filter(|value| !value.is_null()) {
+                validate_text(etag.as_str().ok_or_else(|| invalid("Etag must be a string"))?, 512)?;
+            }
+        }
+        PluginFilesystemOperation::Delete => normalize_bool(params, "recursive")?,
+        PluginFilesystemOperation::Rename | PluginFilesystemOperation::Copy => normalize_bool(params, "overwrite")?,
+        _ => {}
+    }
+    Ok(())
+}
+
+fn optional_u64(params: &Value, key: &str, default: u64) -> Result<u64, PluginRpcError> {
+    match params.get(key).filter(|value| !value.is_null()) {
+        Some(value) => value.as_u64().ok_or_else(|| invalid("Expected an unsigned integer")),
+        None => Ok(default),
+    }
+}
+
+fn normalize_bool(params: &mut Value, key: &str) -> Result<(), PluginRpcError> {
+    let value = match params.get(key).filter(|value| !value.is_null()) {
+        Some(value) => value.as_bool().ok_or_else(|| invalid("Expected a boolean"))?,
+        None => false,
+    };
+    params[key] = json!(value);
+    Ok(())
+}
+
+fn require_capability(
+    capabilities: &PluginFilesystemCapabilities,
+    capability: Capability,
+) -> Result<(), PluginRpcError> {
+    if capabilities.capabilities.contains(&capability) {
+        Ok(())
+    } else {
+        Err(PluginRpcError::host(
+            "unsupported",
+            format!("Filesystem capability '{}' is unavailable", capability.as_str()),
+        ))
+    }
+}
+
+fn required_text<'a>(params: &'a Value, key: &str) -> Result<&'a str, PluginRpcError> {
+    params.get(key).and_then(Value::as_str).ok_or_else(|| invalid(format!("Missing string '{key}'")))
+}
+
+fn validate_text(text: &str, maximum: usize) -> Result<(), PluginRpcError> {
+    if text.trim().is_empty() || text.len() > maximum || text.chars().any(char::is_control) {
+        Err(invalid("Invalid text value"))
+    } else {
+        Ok(())
+    }
+}
+
+fn validate_local_path(path: &str, upload: bool) -> Result<(), PluginRpcError> {
+    validate_text(path, 4096)?;
+    let path = Path::new(path);
+    if !path.is_absolute() || path.components().any(|part| matches!(part, Component::ParentDir)) {
+        return Err(invalid("Local path must be absolute without parent traversal"));
+    }
+    let mut current = std::path::PathBuf::new();
+    for component in path.components() {
+        current.push(component);
+        match std::fs::symlink_metadata(&current) {
+            Ok(metadata) if metadata.file_type().is_symlink() => {
+                return Err(invalid("Local path must not contain symlinks"))
+            }
+            Ok(_) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound && current == path && !upload => {}
+            Err(_) => return Err(invalid("Local path is not accessible")),
+        }
+    }
+    if let Ok(metadata) = std::fs::symlink_metadata(path) {
+        if !metadata.is_file() {
+            return Err(invalid("Local transfer target must be a regular file"));
+        }
+    }
+    // Sidecar must repeat no-follow checks when opening/publishing to close TOCTOU.
+    Ok(())
+}
+
+fn validate_transfer(transfer: &PluginFilesystemTransfer) -> Result<(), PluginRpcError> {
+    validate_text(&transfer.transfer_id, 256)?;
+    if transfer.total_bytes.is_some_and(|total| transfer.bytes_transferred > total) {
+        return Err(invalid("Transfer bytes exceed total"));
+    }
+    Ok(())
+}
+
+fn validate_transfer_binding(
+    transfer: &PluginFilesystemTransfer,
+    provider_id: &str,
+    connection_id: &str,
+) -> Result<(), PluginRpcError> {
+    validate_transfer(transfer)?;
+    if transfer.provider_id.as_deref() != Some(provider_id) || transfer.connection_id.as_deref() != Some(connection_id)
+    {
+        return Err(invalid("Transfer response does not match connection/provider"));
+    }
+    if !matches!(transfer.direction.as_deref(), Some("upload" | "download")) {
+        return Err(invalid("Transfer response has no valid direction"));
+    }
+    validate_text(transfer.uri.as_deref().ok_or_else(|| invalid("Transfer response has no remote URI"))?, 4096)?;
+    Ok(())
+}
+
+fn invalid(message: impl Into<String>) -> PluginRpcError {
+    PluginRpcError::host("invalid_request", message)
+}
