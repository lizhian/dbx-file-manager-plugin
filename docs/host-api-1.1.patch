@@ -0,0 +1,89 @@
+import type { PluginFilesystemCapability, PluginFilesystemEntry, PluginFilesystemProviderContribution, PluginFilesystemTransfer } from "@/types/database";
+
+export const FILESYSTEM_PREVIEW_BYTES = 256 * 1024;
+
+export function filesystemMethodUnavailable(cause: unknown): boolean {
+  if (typeof cause === "string") {
+    try {
+      return filesystemMethodUnavailable(JSON.parse(cause));
+    } catch {
+      return false;
+    }
+  }
+  return !!cause && typeof cause === "object" && "code" in cause && cause.code === -32601;
+}
+
+export function filesystemError(cause: unknown): { code?: number | string; message: string; recovery?: string } {
+  if (typeof cause === "string") {
+    try {
+      return filesystemError(JSON.parse(cause));
+    } catch {
+      return { message: cause };
+    }
+  }
+  if (!cause || typeof cause !== "object") return { message: String(cause) };
+  const value = cause as Record<string, unknown>;
+  const data = value.data && typeof value.data === "object" ? (value.data as Record<string, unknown>) : {};
+  return {
+    code: (data.code ?? value.code) as number | string | undefined,
+    message: typeof value.message === "string" ? value.message : String(cause),
+    recovery: typeof data.recovery === "string" ? data.recovery : data.recovery && typeof data.recovery === "object" ? JSON.stringify(data.recovery) : typeof value.recovery === "string" ? value.recovery : undefined,
+  };
+}
+
+export function filesystemErrorText(cause: unknown): string {
+  const error = filesystemError(cause);
+  return [error.message, error.recovery].filter(Boolean).join(" ");
+}
+
+export function filesystemCapabilities(provider: PluginFilesystemProviderContribution, negotiated?: readonly string[], readOnly = false, desktop = false): Set<PluginFilesystemCapability> {
+  const declared = new Set<PluginFilesystemCapability>(["list", ...(provider.capabilities ?? [])]);
+  // Legacy providers get only their old declared operations, never inferred transfers/stat/copy.
+  const capabilities = new Set<PluginFilesystemCapability>(negotiated === undefined ? [...declared].filter((cap) => ["list", "read", "write", "mkdir", "delete", "rename"].includes(cap)) : [...declared].filter((cap) => negotiated.includes(cap)));
+  if (readOnly) for (const cap of ["write", "mkdir", "delete", "rename", "copy", "upload"] as const) capabilities.delete(cap);
+  if (!desktop) {
+    capabilities.delete("upload");
+    capabilities.delete("download");
+  }
+  return capabilities;
+}
+
+export function filesystemChildUri(parent: string, name: string): string {
+  const trimmed = name.trim();
+  if (!trimmed || trimmed === "." || trimmed === ".." || /[/\\]/.test(trimmed) || [...trimmed].some((character) => character.charCodeAt(0) < 32)) throw new Error("Invalid file name");
+  return `${parent.replace(/\/$/, "")}/${encodeURIComponent(trimmed)}`;
+}
+
+export function mergeFilesystemEntries(previous: readonly PluginFilesystemEntry[], incoming: readonly PluginFilesystemEntry[]): PluginFilesystemEntry[] {
+  return [...new Map([...previous, ...incoming].map((entry) => [entry.uri, entry])).values()];
+}
+
+export function formatFilesystemSize(size?: number): string {
+  if (size === undefined) return "";
+  if (size < 1024) return `${size} B`;
+  if (size < 1024 ** 2) return `${(size / 1024).toFixed(1)} KB`;
+  if (size < 1024 ** 3) return `${(size / 1024 ** 2).toFixed(1)} MB`;
+  return `${(size / 1024 ** 3).toFixed(1)} GB`;
+}
+
+export function decodeFilesystemPreview(dataBase64: string, truncated = false): string | undefined {
+  if (dataBase64.length > Math.ceil(FILESYSTEM_PREVIEW_BYTES / 3) * 4) throw new Error("Preview exceeds byte limit");
+  const bytes = Uint8Array.from(atob(dataBase64), (character) => character.charCodeAt(0));
+  if (bytes.byteLength > FILESYSTEM_PREVIEW_BYTES) throw new Error("Preview exceeds byte limit");
+  if (bytes.includes(0)) return undefined;
+  try {
+    return new TextDecoder("utf-8", { fatal: true }).decode(bytes, { stream: truncated });
+  } catch {
+    return undefined;
+  }
+}
+
+export function activeFilesystemTransfer(task: PluginFilesystemTransfer): boolean {
+  return task.state === "queued" || task.state === "running";
+}
+
+export function mergeFilesystemTransfer(previous: PluginFilesystemTransfer | undefined, incoming: PluginFilesystemTransfer): PluginFilesystemTransfer {
+  // Late start responses/progress events must not resurrect a terminal task.
+  if (previous && !activeFilesystemTransfer(previous)) return previous;
+  return { ...incoming, state: previous?.state === "running" && incoming.state === "queued" ? "running" : incoming.state, bytesTransferred: Math.max(previous?.bytesTransferred ?? 0, incoming.bytesTransferred) };
+}
