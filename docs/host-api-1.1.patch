+// @vitest-environment happy-dom
+import { createApp, defineComponent, h, nextTick, reactive, type App } from "vue";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({ list: vi.fn(), active: vi.fn(), persist: vi.fn(), store: {} as { activeTabId: string; tabs: { id: string; connectionId: string; pluginFilesystem: { pluginId: string; providerId: string; currentUri: string } }[]; flushPendingPersist: () => Promise<void> } }));
+vi.mock("@/lib/backend/api", () => ({ listPlugins: mocks.list, listActivePlugins: mocks.active }));
+vi.mock("@/stores/queryStore", () => ({ useQueryStore: () => mocks.store }));
+vi.mock("vue-i18n", () => ({ useI18n: () => ({ t: (key: string) => key, locale: { value: "en" } }) }));
+vi.mock("@/lib/plugins/frontendPlugin", () => ({ createFrontendPluginRegistry: (entries: unknown[]) => ({ listFilesystemProviders: () => entries }) }));
+vi.mock("@/components/ui/button", () => ({
+  Button: defineComponent({
+    setup(_, { attrs, slots }) {
+      return () => h("button", attrs, slots.default?.());
+    },
+  }),
+}));
+vi.mock("./PluginFileManager.vue", () => ({
+  default: defineComponent({
+    props: { initialUri: String },
+    emits: ["navigate"],
+    setup(props, { emit }) {
+      return () => h("button", { "data-manager": true, "data-uri": props.initialUri, onClick: () => emit("navigate", "sample:/next/") }, "navigate");
+    },
+  }),
+}));
+import PluginFilesystemTab from "./PluginFilesystemTab.vue";
+
+let app: App | undefined;
+let root: HTMLDivElement;
+async function flush() {
+  for (let i = 0; i < 20; i++) await Promise.resolve();
+  await nextTick();
+}
+afterEach(() => {
+  app?.unmount();
+  app = undefined;
+  root?.remove();
+  vi.useRealTimers();
+  vi.clearAllMocks();
+});
+
+async function mount() {
+  mocks.store = reactive({
+    activeTabId: "original",
+    tabs: [
+      { id: "original", connectionId: "c", pluginFilesystem: { pluginId: "plugin", providerId: "files", currentUri: "sample:/saved/" } },
+      { id: "other", connectionId: "c", pluginFilesystem: { pluginId: "plugin", providerId: "files", currentUri: "sample:/other/" } },
+    ],
+    flushPendingPersist: mocks.persist,
+  });
+  mocks.persist.mockResolvedValue(undefined);
+  mocks.active.mockResolvedValue([{ pluginId: "plugin", state: "running" }]);
+  mocks.list.mockResolvedValue([{ plugin: { manifest: { id: "plugin", version: "1" } }, contribution: { id: "files", schemes: ["sample"], capabilities: ["read"] } }]);
+  root = document.createElement("div");
+  document.body.append(root);
+  app = createApp({ render: () => h(PluginFilesystemTab, { pluginId: "plugin", providerId: "files", connectionId: "c", initialUri: "sample:/saved/" }) });
+  app.mount(root);
+  await flush();
+}
+
+describe("persisted filesystem tabs", () => {
+  it("restores the URI and flushes navigation into its own tab, not the newly active tab", async () => {
+    await mount();
+    expect(root.querySelector("[data-manager]")!.getAttribute("data-uri")).toBe("sample:/saved/");
+    mocks.store.activeTabId = "other";
+    root.querySelector<HTMLButtonElement>("[data-manager]")!.click();
+    await flush();
+    expect(mocks.store.tabs[0].pluginFilesystem.currentUri).toBe("sample:/next/");
+    expect(mocks.store.tabs[1].pluginFilesystem.currentUri).toBe("sample:/other/");
+    expect(mocks.persist).toHaveBeenCalledTimes(1);
+  });
+  it("removes an unavailable provider and clears lifecycle polling on unmount", async () => {
+    vi.useFakeTimers();
+    await mount();
+    mocks.list.mockResolvedValue([]);
+    await vi.advanceTimersByTimeAsync(10000);
+    await flush();
+    expect(root.querySelector("[data-manager]")).toBeNull();
+    expect(root.textContent).toContain("pluginPlatform.filesystemUnavailable");
+    app!.unmount();
+    app = undefined;
+    const calls = mocks.list.mock.calls.length;
+    await vi.advanceTimersByTimeAsync(20000);
+    expect(mocks.list).toHaveBeenCalledTimes(calls);
+  });
+  it("surfaces a stopped backend and retries the native manager after explicit refresh", async () => {
+    vi.useFakeTimers();
+    await mount();
+    mocks.active.mockResolvedValue([{ pluginId: "plugin", state: "exited" }]);
+    await vi.advanceTimersByTimeAsync(10000);
+    await flush();
+    expect(root.querySelector("[data-manager]")).toBeNull();
+    expect(root.textContent).toContain("hostFilesystem.processUnavailable");
+    root.querySelector<HTMLButtonElement>("button")!.click();
+    await flush();
+    expect(root.querySelector("[data-manager]")).not.toBeNull();
+  });
+});
