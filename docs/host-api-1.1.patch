+async function postPluginFilesystem<T>(url: string, body: unknown): Promise<T> {
+  const response = await fetch(apiUrl(url), { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
+  if (!response.ok) {
+    const text = await response.text();
+    let payload: unknown = text;
+    try {
+      payload = JSON.parse(text);
+    } catch {
+      /* Legacy plain-text server error. */
+    }
+    // Filesystem conflict/recovery handling needs the original SDK envelope.
+    if (payload && typeof payload === "object" && "code" in payload && typeof payload.code === "number" && "message" in payload && typeof payload.message === "string") throw payload;
+    throw new BackendErrorException(payload);
+  }
+  return response.json();
+}
