diff --git a/apps/desktop/src/lib/__tests__/connection/connectionDialogPluginConfig.spec.ts b/apps/desktop/src/lib/__tests__/connection/connectionDialogPluginConfig.spec.ts
new file mode 100644
index 000000000..342ea489b
--- /dev/null
+++ b/apps/desktop/src/lib/__tests__/connection/connectionDialogPluginConfig.spec.ts
@@ -0,0 +1,51 @@
+import { describe, expect, it } from "vitest";
+import { parse } from "vue/compiler-sfc";
+import ts from "typescript";
+import dialogSource from "@/components/connection/ConnectionDialog.vue?raw";
+import { buildPluginConnectionConfig } from "@/lib/plugins/frontendPlugin";
+import { isDoltDriverProfile } from "@/lib/database/doltProfile";
+
+function submitCleanup(config: { db_type: string; driver_profile?: string; external_config?: unknown }) {
+  const script = parse(dialogSource).descriptor.scriptSetup!.content;
+  const source = ts.createSourceFile("ConnectionDialog.ts", script, ts.ScriptTarget.Latest, true);
+  let cleanup: ts.IfStatement | undefined;
+  function visit(node: ts.Node) {
+    if (ts.isIfStatement(node) && node.expression.getText(source).includes("isDoltDriverProfile") && node.thenStatement.getText(source).includes("config.external_config = undefined")) cleanup = node;
+    ts.forEachChild(node, visit);
+  }
+  visit(source);
+  expect(cleanup, "Locate the dialog's final generic external-config cleanup").toBeDefined();
+  // Execute the actual submission branch, not a copy of its condition.
+  new Function("config", "isDoltDriverProfile", `if (${cleanup!.expression.getText(source)}) ${cleanup!.thenStatement.getText(source)}`)(config, isDoltDriverProfile);
+}
+
+describe("plugin connection submission", () => {
+  it("preserves declared config fields and separate secrets through generic cleanup", () => {
+    const config = buildPluginConnectionConfig(
+      "sample",
+      {
+        type: "connection-provider",
+        id: "sample.files",
+        label: "Files",
+        database_type: "files",
+        fields: [
+          { key: "root", label: "Remote root", type: "text", binding: "config", required: true },
+          { key: "password", label: "Password", type: "password", binding: "secret" },
+        ],
+      },
+      { root: "/scoped/", password: "throwaway-test-secret" },
+    );
+    submitCleanup(config);
+    expect(config.external_config).toEqual({ root: "/scoped/" });
+    expect(config.connection_secrets).toEqual({ password: "throwaway-test-secret" });
+  });
+
+  it("retains Dolt configuration and still clears unrelated driver configuration", () => {
+    const dolt = { db_type: "mysql", driver_profile: "dolt", external_config: { branch: "main" } };
+    const mysql = { db_type: "mysql", driver_profile: "mysql", external_config: { stale: true } };
+    submitCleanup(dolt);
+    submitCleanup(mysql);
+    expect(dolt.external_config).toEqual({ branch: "main" });
+    expect(mysql.external_config).toBeUndefined();
+  });
+});
