@@ -0,0 +1,185 @@
+//! Run against the disposable FTP fixture, never a production connection.
+use std::path::PathBuf;
+use std::time::Duration;
+
+use base64::Engine;
+use dbx_core::connection::AppState;
+use dbx_core::models::connection::ConnectionConfig;
+use dbx_core::plugins::{
+    PluginFilesystemOperation as Op, PluginFilesystemTransfer, PluginFilesystemTransferOperation as TransferOp,
+    PluginFilesystemTransferState, PluginInstallPolicy, PluginPackageInstaller,
+};
+use dbx_core::storage::Storage;
+use serde_json::{json, Value};
+
+const ID: &str = "io.github.lizhian.file-manager";
+const PROVIDER: &str = "io.github.lizhian.file-manager.ftp.files";
+const CONNECTION: &str = "isolated-plugin-smoke";
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let package =
+        std::env::args().nth(1).map(PathBuf::from).ok_or("Usage: file_manager_plugin_smoke <package.dbxp>")?;
+    let temporary = tempfile::tempdir()?;
+    let root = temporary.path().canonicalize()?;
+    let installer = PluginPackageInstaller::new(root.join("plugins"), "0.6.1")?;
+    let installed = installer.install_file(&package, PluginInstallPolicy::LocalDevelopment)?;
+    if installed.plugin.manifest.id != ID {
+        return Err("Unexpected plugin ID".into());
+    }
+    let storage = Storage::open(&root.join("storage.db")).await?;
+    let state = AppState::new_with_plugin_dir_and_app_version(storage, root.join("plugins"), "0.6.1");
+    let result = run(&state, &root).await;
+    state.plugin_host.stop_all().await;
+    let uninstall = installer.uninstall(ID);
+    result?;
+    uninstall?;
+    println!("PASS: real package install, lifecycle, filesystem, structured errors, 5 MiB transfers, read-only guard, cleanup");
+    Ok(())
+}
+
+async fn run(state: &AppState, local: &std::path::Path) -> Result<(), Box<dyn std::error::Error>> {
+    let config: ConnectionConfig = serde_json::from_value(json!({
+        "id": CONNECTION, "name": "Isolated FTP smoke", "db_type": "plugin", "driver_profile": "plugin",
+        "host": "127.0.0.1", "port": 2121, "username": "dbx", "password": "", "database": null,
+        "plugin_id": ID, "plugin_connection_provider": "io.github.lizhian.file-manager.ftp",
+        "plugin_connection_type": "ftp", "external_config": { "root": "/ftp/dbx/" },
+        "connection_secrets": { "password": std::env::var("DBX_SMOKE_FTP_PASSWORD").unwrap_or_else(|_| "dbx-password".into()) }
+    }))?;
+    state.storage.save_connections(std::slice::from_ref(&config)).await?;
+    state.plugin_host.test_connection(&config, &config.host, config.port).await?;
+    let connection = state.plugin_host.connect_connection(&config, &config.host, config.port).await?;
+    let prefix = format!("ftp:/dbx-plugin-smoke-{}", uuid::Uuid::new_v4());
+    let result = exercise(state, local, &prefix).await;
+    let mut cleanup_errors = Vec::new();
+    // All cleanup is restricted to the UUID prefix created by this invocation.
+    for name in ["source.txt", "copy.txt", "renamed.txt", "large.bin"] {
+        if let Err(error) =
+            operation(state, Op::Delete, json!({"uri": format!("{prefix}/{name}"), "recursive": false})).await
+        {
+            if error.data.as_ref().and_then(|data| data["code"].as_str()) != Some("not_found") {
+                cleanup_errors.push(error.to_string());
+            }
+        }
+    }
+    if let Err(error) = operation(state, Op::Delete, json!({"uri": prefix, "recursive": false})).await {
+        if error.data.as_ref().and_then(|data| data["code"].as_str()) != Some("not_found") {
+            cleanup_errors.push(error.to_string());
+        }
+    }
+    let disconnect = connection.disconnect().await;
+    if !cleanup_errors.is_empty() {
+        eprintln!("Remote cleanup failed: {}", cleanup_errors.join("; "));
+    }
+    result?;
+    disconnect?;
+    if !cleanup_errors.is_empty() {
+        return Err("Remote fixture cleanup failed".into());
+    }
+    Ok(())
+}
+
+async fn operation(state: &AppState, op: Op, params: Value) -> Result<Value, dbx_core::plugins::PluginRpcError> {
+    state.invoke_plugin_filesystem(ID, PROVIDER, Some(CONNECTION), op, params).await
+}
+
+async fn exercise(state: &AppState, local: &std::path::Path, prefix: &str) -> Result<(), Box<dyn std::error::Error>> {
+    let capabilities = state.plugin_filesystem_capabilities(ID, PROVIDER, Some(CONNECTION)).await?;
+    if capabilities.capabilities.is_empty() {
+        return Err("No runtime filesystem capabilities".into());
+    }
+    operation(state, Op::CreateDirectory, json!({"uri": prefix})).await?;
+    let source = format!("{prefix}/source.txt");
+    operation(
+        state,
+        Op::Write,
+        json!({
+            "uri": source, "dataBase64": "aGVsbG8=", "create": true, "overwrite": false
+        }),
+    )
+    .await?;
+    let stat = operation(state, Op::Stat, json!({"uri": source})).await?;
+    if stat["size"] != 5 {
+        return Err("Stat size mismatch".into());
+    }
+    let copied = format!("{prefix}/copy.txt");
+    operation(state, Op::Copy, json!({"sourceUri": source, "targetUri": copied, "overwrite": false})).await?;
+    let duplicate =
+        operation(state, Op::Copy, json!({"sourceUri": source, "targetUri": copied, "overwrite": false})).await;
+    if duplicate.as_ref().err().and_then(|e| e.data.as_ref()).and_then(|d| d["code"].as_str()) != Some("already_exists")
+    {
+        return Err("Duplicate copy did not preserve structured already_exists error".into());
+    }
+    let renamed = format!("{prefix}/renamed.txt");
+    operation(state, Op::Rename, json!({"sourceUri": copied, "targetUri": renamed, "overwrite": false})).await?;
+    let preview = operation(state, Op::Read, json!({"uri": renamed, "maxBytes": 3})).await?;
+    let bytes =
+        base64::engine::general_purpose::STANDARD.decode(preview["dataBase64"].as_str().ok_or("Missing preview")?)?;
+    if bytes != b"hel" || preview["truncated"] != true {
+        return Err("Bounded preview mismatch".into());
+    }
+    let listing = operation(state, Op::List, json!({"uri": prefix, "limit": 1})).await?;
+    if listing["entries"].as_array().is_none_or(|entries| entries.len() != 1) {
+        return Err("Pagination limit mismatch".into());
+    }
+
+    let source_path = local.join("source.bin");
+    let target_path = local.join("download.bin");
+    let data = vec![0x5a; 5 * 1024 * 1024];
+    tokio::fs::write(&source_path, &data).await?;
+    for (op, path) in [(TransferOp::Upload, &source_path), (TransferOp::Download, &target_path)] {
+        let transfer: PluginFilesystemTransfer = state
+            .invoke_plugin_filesystem_transfer(
+                ID,
+                PROVIDER,
+                CONNECTION,
+                op,
+                json!({"uri": format!("{prefix}/large.bin"), "localPath": path, "overwrite": false}),
+            )
+            .await?;
+        wait_transfer(state, &transfer.transfer_id).await?;
+    }
+    if tokio::fs::read(target_path).await? != data {
+        return Err("Downloaded bytes differ".into());
+    }
+
+    let mut saved = state.storage.load_connections().await?;
+    saved[0].read_only = true;
+    state.storage.save_connections(&saved).await?;
+    let denied = operation(state, Op::Delete, json!({"uri": source})).await;
+    saved[0].read_only = false;
+    state.storage.save_connections(&saved).await?;
+    if denied.is_ok() {
+        return Err("Host failed to enforce updated saved read-only policy".into());
+    }
+    Ok(())
+}
+
+async fn wait_transfer(state: &AppState, id: &str) -> Result<(), Box<dyn std::error::Error>> {
+    tokio::time::timeout(Duration::from_secs(120), async {
+        let mut previous = 0;
+        loop {
+            let task: PluginFilesystemTransfer = state
+                .invoke_plugin_filesystem_transfer(
+                    ID,
+                    PROVIDER,
+                    CONNECTION,
+                    TransferOp::Status,
+                    json!({"transferId": id}),
+                )
+                .await?;
+            if task.bytes_transferred < previous {
+                return Err("Transfer progress went backwards".into());
+            }
+            previous = task.bytes_transferred;
+            match task.state {
+                PluginFilesystemTransferState::Completed => return Ok::<(), Box<dyn std::error::Error>>(()),
+                PluginFilesystemTransferState::Failed | PluginFilesystemTransferState::Cancelled => {
+                    return Err("Transfer failed or cancelled".into())
+                }
+                _ => tokio::time::sleep(Duration::from_millis(100)).await,
+            }
+        }
+    })
+    .await?
+}
