+//! Opt-in host/real-sidecar contract against the disposable loopback FTP fixture.
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use serde_json::{json, Value};
+
+use crate::connection::AppState;
+use crate::models::connection::ConnectionConfig;
+use crate::storage::Storage;
+
+use super::{
+    PluginFilesystemCapability as Capability, PluginFilesystemEntry, PluginFilesystemOperation as Operation,
+    PluginFilesystemTransfer, PluginFilesystemTransferList, PluginFilesystemTransferOperation as TransferOperation,
+    PluginFilesystemTransferState, PluginManifest, PluginRpcError, PLUGIN_FILESYSTEM_TRANSFER_PROGRESS_EVENT,
+};
+
+const PLUGIN: &str = "io.github.lizhian.file-manager";
+const PROVIDER: &str = "io.github.lizhian.file-manager.ftp.files";
+const CONNECTION: &str = "host-gateway-integration";
+type TestResult = Result<(), Box<dyn std::error::Error>>;
+
+#[tokio::test]
+#[ignore = "requires DBX_FILE_MANAGER_PLUGIN_DIR, DBX_FILE_MANAGER_PLUGIN_BINARY and disposable FTP on 127.0.0.1:2121"]
+async fn real_file_manager_sidecar_through_saved_host_gateway() -> TestResult {
+    let source = PathBuf::from(std::env::var("DBX_FILE_MANAGER_PLUGIN_DIR")?);
+    let binary = PathBuf::from(std::env::var("DBX_FILE_MANAGER_PLUGIN_BINARY")?);
+    let root = tempfile::tempdir()?;
+    let local = root.path().canonicalize()?;
+    let plugins = local.join("plugins");
+    let package = plugins.join(PLUGIN);
+    std::fs::create_dir_all(package.join("assets"))?;
+    std::fs::copy(binary, package.join("sidecar"))?;
+    std::fs::copy(source.join("assets/plugin.svg"), package.join("assets/plugin.svg"))?;
+    let mut manifest: PluginManifest = serde_json::from_slice(&std::fs::read(source.join("manifest.json"))?)?;
+    manifest.entrypoints.backend.as_mut().ok_or("Missing backend entrypoint")?.executable = "sidecar".into();
+    std::fs::write(package.join("manifest.json"), serde_json::to_vec(&manifest)?)?;
+
+    let storage = Storage::open(&local.join("storage.db")).await?;
+    let state = AppState::new_with_plugin_dir_and_app_version(storage, plugins, "0.6.1");
+    let config: ConnectionConfig = serde_json::from_value(json!({
+        "id": CONNECTION, "name": "Disposable FTP host integration", "db_type": "plugin",
+        "host": "127.0.0.1", "port": 2121, "username": "dbx", "password": "",
+        "plugin_id": PLUGIN, "plugin_connection_provider": "io.github.lizhian.file-manager.ftp",
+        "plugin_connection_type": "ftp", "external_config": {"root": "/ftp/dbx/"},
+        "connection_secrets": {"password": "dbx-password"}
+    }))?;
+    state.storage.save_connections(std::slice::from_ref(&config)).await?;
+    let prefix = format!("ftp:/host-gateway-{}", uuid::Uuid::new_v4());
+    let result = tokio::time::timeout(Duration::from_secs(120), exercise(&state, &config, &local, &prefix)).await;
+
+    // Restore policy before best-effort cleanup even when an assertion fails.
+    let _ = state.storage.save_connections(std::slice::from_ref(&config)).await;
+    for suffix in ["/source.txt", "/copy.txt", "/large.bin", ""] {
+        let _ = tokio::time::timeout(
+            Duration::from_secs(10),
+            remote::<Value>(&state, Operation::Delete, json!({"uri": format!("{prefix}{suffix}"), "recursive": false})),
+        )
+        .await;
+    }
+    state.plugin_host.stop_all().await;
+    result?
+}
+
+async fn remote<T: serde::de::DeserializeOwned>(
+    state: &AppState,
+    operation: Operation,
+    params: Value,
+) -> Result<T, PluginRpcError> {
+    state.invoke_plugin_filesystem(PLUGIN, PROVIDER, Some(CONNECTION), operation, params).await
+}
+
+fn require(condition: bool, message: &'static str) -> TestResult {
+    if condition {
+        Ok(())
+    } else {
+        Err(message.into())
+    }
+}
+
+async fn exercise(state: &AppState, config: &ConnectionConfig, local: &Path, prefix: &str) -> TestResult {
+    state.plugin_host.test_connection(config, &config.host, config.port).await?;
+    // Keep the backend connection alive for cleanup; the outer test stops the
+    // entire temporary host after deleting its UUID-scoped remote objects.
+    let _handle = state.plugin_host.connect_connection(config, &config.host, config.port).await?;
+    let mut events = state.plugin_host.subscribe_events();
+    let capabilities = state.plugin_filesystem_capabilities(PLUGIN, PROVIDER, Some(CONNECTION)).await?;
+    for capability in [Capability::Stat, Capability::Copy, Capability::Upload, Capability::Download] {
+        require(capabilities.capabilities.contains(&capability), "Expected live FTP capability missing")?;
+    }
+    for method in [
+        "filesystem/transfer/startUpload",
+        "filesystem/transfer/startDownload",
+        "connection/connect",
+        "plugin/initialize",
+    ] {
+        let result = state.plugin_host.invoke_typed::<Value>(PLUGIN, method, json!({}), None, None).await;
+        require(
+            result.err().and_then(|error| error.data).is_some_and(|data| data["code"] == "host_only_method"),
+            "Generic invoke allowed reserved method",
+        )?;
+        require(
+            state.plugin_host.notify(PLUGIN, method, json!({}), None).await.is_err(),
+            "Generic notify allowed reserved method",
+        )?;
+    }
+    let wrong_binding = state
+        .invoke_plugin_filesystem::<Value>(
+            PLUGIN,
+            "io.github.lizhian.file-manager.s3.files",
+            Some(CONNECTION),
+            Operation::List,
+            json!({}),
+        )
+        .await;
+    require(wrong_binding.is_err(), "Host accepted another provider's connection")?;
+    remote::<Value>(state, Operation::CreateDirectory, json!({"uri": prefix})).await?;
+    let source_uri = format!("{prefix}/source.txt");
+    remote::<Value>(state, Operation::Write, json!({"uri": source_uri, "dataBase64": "aGVsbG8=", "create": true}))
+        .await?;
+    let entry: PluginFilesystemEntry = remote(state, Operation::Stat, json!({"uri": source_uri})).await?;
+    require(entry.size == Some(5) && entry.uri == source_uri, "Stat did not return normalized entry")?;
+    let copy = json!({"sourceUri": source_uri, "targetUri": format!("{prefix}/copy.txt"), "overwrite": false});
+    remote::<Value>(state, Operation::Copy, copy.clone()).await?;
+    let duplicate = remote::<Value>(state, Operation::Copy, copy).await;
+    require(
+        duplicate.err().and_then(|error| error.data).is_some_and(|data| data["code"] == "already_exists"),
+        "SDK error data lost through host",
+    )?;
+
+    let mut read_only = config.clone();
+    read_only.read_only = true;
+    state.storage.save_connections(&[read_only]).await?;
+    let capabilities = state.plugin_filesystem_capabilities(PLUGIN, PROVIDER, Some(CONNECTION)).await?;
+    require(
+        !capabilities.capabilities.contains(&Capability::Upload)
+            && capabilities.capabilities.contains(&Capability::Download),
+        "Saved read-only capability mask failed",
+    )?;
+    let denied = remote::<Value>(state, Operation::Delete, json!({"uri": source_uri})).await;
+    require(
+        denied.err().and_then(|error| error.data).is_some_and(|data| data["code"] == "read_only"),
+        "Saved read-only did not reject mutation",
+    )?;
+    let generic_denied = state
+        .invoke_plugin_generic::<Value>(
+            PLUGIN,
+            "filesystem/delete",
+            json!({"providerId": PROVIDER, "connectionId": CONNECTION, "uri": source_uri}),
+            None,
+        )
+        .await;
+    require(
+        generic_denied.err().and_then(|error| error.data).is_some_and(|data| data["code"] == "read_only"),
+        "Generic mutation bypassed saved policy with a stale writable sidecar",
+    )?;
+    let generic_stat: PluginFilesystemEntry = state
+        .invoke_plugin_generic(
+            PLUGIN,
+            "filesystem/stat",
+            json!({"providerId": PROVIDER, "connectionId": CONNECTION, "uri": source_uri}),
+            None,
+        )
+        .await?;
+    require(generic_stat.size == Some(5), "Generic read compatibility failed")?;
+    state.storage.save_connections(std::slice::from_ref(config)).await?;
+
+    let data = vec![0x5a; 5 * 1024 * 1024];
+    let source = local.join("upload.bin");
+    let destination = local.join("download.bin");
+    tokio::fs::write(&source, &data).await?;
+    for (operation, path) in [(TransferOperation::Upload, &source), (TransferOperation::Download, &destination)] {
+        let started: PluginFilesystemTransfer = state
+            .invoke_plugin_filesystem_transfer(
+                PLUGIN,
+                PROVIDER,
+                CONNECTION,
+                operation,
+                json!({"uri": format!("{prefix}/large.bin"), "localPath": path, "overwrite": false}),
+            )
+            .await?;
+        require(
+            !started.transfer_id.is_empty() && started.provider_id.as_deref() == Some(PROVIDER),
+            "Start snapshot not normalized",
+        )?;
+        let mut previous = 0;
+        loop {
+            let event = events.recv().await?;
+            if event.method != PLUGIN_FILESYSTEM_TRANSFER_PROGRESS_EVENT
+                || event.params["transferId"] != started.transfer_id
+            {
+                continue;
+            }
+            let progress: PluginFilesystemTransfer = serde_json::from_value(event.params)?;
+            require(progress.bytes_transferred >= previous, "Progress went backwards")?;
+            previous = progress.bytes_transferred;
+            if progress.state == PluginFilesystemTransferState::Completed {
+                require(previous == data.len() as u64, "Transfer byte count mismatch")?;
+                break;
+            }
+            require(
+                !matches!(
+                    progress.state,
+                    PluginFilesystemTransferState::Failed | PluginFilesystemTransferState::Cancelled
+                ),
+                "Real transfer failed",
+            )?;
+        }
+        let status: PluginFilesystemTransfer = state
+            .invoke_plugin_filesystem_transfer(
+                PLUGIN,
+                PROVIDER,
+                CONNECTION,
+                TransferOperation::Status,
+                json!({"transferId": started.transfer_id}),
+            )
+            .await?;
+        require(status.state == PluginFilesystemTransferState::Completed, "Completed event/status mismatch")?;
+    }
+    require(tokio::fs::read(destination).await? == data, "Downloaded content mismatch")?;
+    let transfers: PluginFilesystemTransferList = state
+        .invoke_plugin_filesystem_transfer(PLUGIN, PROVIDER, CONNECTION, TransferOperation::List, json!({}))
+        .await?;
+    require(transfers.transfers.len() == 2, "Transfer list scope mismatch")?;
+    Ok(())
+}
