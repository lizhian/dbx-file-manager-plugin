+pub const PLUGIN_FILESYSTEM_STAT_METHOD: &str = "filesystem/stat";
+pub const PLUGIN_FILESYSTEM_COPY_METHOD: &str = "filesystem/copy";
+pub const PLUGIN_FILESYSTEM_CAPABILITIES_METHOD: &str = "filesystem/capabilities";
+pub const PLUGIN_FILESYSTEM_TRANSFER_PROGRESS_EVENT: &str = "filesystem/transfer/progress";
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PluginFilesystemCapabilities {
+    pub capabilities: Vec<Capability>,
+    #[serde(flatten)]
+    pub details: BTreeMap<String, Value>,
+}
+
+#[derive(Debug, Clone, Copy)]
+pub enum PluginFilesystemOperation {
+    List,
+    Stat,
+    Read,
+    Write,
+    CreateDirectory,
+    Delete,
+    Rename,
+    Copy,
+}
+
+impl PluginFilesystemOperation {
+    fn method(self) -> &'static str {
+        match self {
+            Self::List => "filesystem/list",
+            Self::Stat => PLUGIN_FILESYSTEM_STAT_METHOD,
+            Self::Read => "filesystem/read",
+            Self::Write => "filesystem/write",
+            Self::CreateDirectory => "filesystem/createDirectory",
+            Self::Delete => "filesystem/delete",
+            Self::Rename => "filesystem/rename",
+            Self::Copy => PLUGIN_FILESYSTEM_COPY_METHOD,
+        }
+    }
+
+    fn capability(self) -> Capability {
+        match self {
+            Self::List => Capability::List,
+            Self::Stat => Capability::Stat,
+            Self::Read => Capability::Read,
+            Self::Write => Capability::Write,
+            Self::CreateDirectory => Capability::Mkdir,
+            Self::Delete => Capability::Delete,
+            Self::Rename => Capability::Rename,
+            Self::Copy => Capability::Copy,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+pub enum PluginFilesystemTransferOperation {
+    Upload,
+    Download,
+    Cancel,
+    Status,
+    List,
+}
+
+impl PluginFilesystemTransferOperation {
+    fn method(self) -> &'static str {
+        match self {
+            Self::Upload => "filesystem/transfer/startUpload",
+            Self::Download => "filesystem/transfer/startDownload",
+            Self::Cancel => "filesystem/transfer/cancel",
+            Self::Status => "filesystem/transfer/status",
+            Self::List => "filesystem/transfer/list",
+        }
+    }
+}
