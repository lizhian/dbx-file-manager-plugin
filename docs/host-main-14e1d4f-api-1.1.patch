+  previewError.value = "";
+  previewType.value = "";
+  previewTruncated.value = false;
+}
+
+async function load(uri = currentUri.value, append = false) {
+  if (!can("list") || disposed || (append && (loading.value || loadingMore.value || !nextCursor.value))) return;
+  const generation = ++listGeneration;
+  const target = uri.trim() || rootUri.value;
+  if (append) loadingMore.value = true;
+  else {
+    loading.value = true;
+    loadingMore.value = false;
+    clearPreview();
+    expanded.value.clear();
+    children.value.clear();
+    childCursors.value.clear();
+    childErrors.value.clear();
+    childLoading.value.clear();
+  }
+  error.value = "";
+  try {
+    const cursor = append ? nextCursor.value : undefined;
+    const result = await api.listPluginFilesystemEntries(props.pluginId, props.provider.id, { connectionId: props.connectionId, uri: target, cursor, limit: 200 });
+    if (disposed || generation !== listGeneration) return;
+    entries.value = mergeFilesystemEntries(append ? entries.value : [], result.entries);
+    nextCursor.value = result.nextCursor === cursor ? undefined : result.nextCursor;
+    currentUri.value = target;
+    address.value = target;
+    emit("navigate", target);
+  } catch (cause) {
+    if (!disposed && generation === listGeneration) error.value = filesystemErrorText(cause);
+  } finally {
+    if (!disposed && generation === listGeneration) {
+      loading.value = false;
+      loadingMore.value = false;
+    }
+  }
+}
+
+async function loadChildren(entry: PluginFilesystemEntry, append = false) {
+  if (!can("list") || childLoading.value.has(entry.uri) || loading.value) return;
+  const generation = listGeneration;
+  childLoading.value.add(entry.uri);
+  childErrors.value.delete(entry.uri);
+  try {
+    const cursor = append ? childCursors.value.get(entry.uri) : undefined;
+    const result = await api.listPluginFilesystemEntries(props.pluginId, props.provider.id, { connectionId: props.connectionId, uri: entry.uri, cursor, limit: 200 });
+    if (disposed || generation !== listGeneration) return;
+    children.value.set(entry.uri, mergeFilesystemEntries(append ? children.value.get(entry.uri) || [] : [], result.entries));
+    childCursors.value.set(entry.uri, result.nextCursor === cursor ? undefined : result.nextCursor);
+  } catch (cause) {
+    if (!disposed && generation === listGeneration) childErrors.value.set(entry.uri, filesystemErrorText(cause));
+  } finally {
+    if (!disposed && generation === listGeneration) childLoading.value.delete(entry.uri);
+  }
+}
+
+async function toggleDirectory(entry: PluginFilesystemEntry) {
+  if (expanded.value.has(entry.uri)) expanded.value.delete(entry.uri);
+  else {
+    expanded.value.add(entry.uri);
+    if (!children.value.has(entry.uri)) await loadChildren(entry);
+  }
+}
+
+async function activate(entry: PluginFilesystemEntry) {
+  if (loading.value) return;
+  if (entry.kind === "directory") {
+    await load(entry.uri);
+    return;
+  }
+  clearPreview(entry);
+  if (entry.kind !== "file" || !can("read")) {
+    previewError.value = t("pluginPlatform.entryCannotPreview");
+    return;
+  }
+  const generation = previewGeneration;
+  previewLoading.value = true;
+  try {
+    if (can("stat")) {
+      const stat = await api.statPluginFilesystemEntry(props.pluginId, props.provider.id, entry.uri, props.connectionId);
+      if (disposed || generation !== previewGeneration) return;
+      selected.value = stat;
+      if (stat.kind !== "file") throw new Error(t("pluginPlatform.entryCannotPreview"));
+    }
+    const result = await api.readPluginFilesystemFile(props.pluginId, props.provider.id, entry.uri, { connectionId: props.connectionId, maxBytes: FILESYSTEM_PREVIEW_BYTES });
+    if (disposed || generation !== previewGeneration) return;
+    preview.value = decodeFilesystemPreview(result.dataBase64, result.truncated);
+    previewType.value = result.contentType || entry.contentType || "application/octet-stream";
+    previewTruncated.value = result.truncated;
+    if (preview.value === undefined) previewError.value = t("hostFilesystem.binaryPreview");
+  } catch (cause) {
+    if (!disposed && generation === previewGeneration) previewError.value = filesystemErrorText(cause);
+  } finally {
+    if (!disposed && generation === previewGeneration) previewLoading.value = false;
+  }
+}
+
+function permitted(operation: Operation, entry?: PluginFilesystemEntry) {
+  if (!can(operation) || busy.value || loading.value) return false;
+  if (operation === "copy" || operation === "download") return entry?.kind === "file";
+  return !entry || entry.kind === "file" || entry.kind === "directory";
+}
+
+async function begin(operation: Operation, entry?: PluginFilesystemEntry) {
+  if (!permitted(operation, entry)) return;
+  operationError.value = "";
+  replace.value = false;
+  const generation = contextGeneration;
+  if (operation === "upload" || operation === "download") {
+    busy.value = true;
+    try {
+      const dialog = await import("@tauri-apps/plugin-dialog");
+      const path = operation === "upload" ? await dialog.open({ multiple: false, directory: false }) : await dialog.save({ defaultPath: entry!.name.replace(/[/\\]/g, "_") });
+      if (disposed || generation !== contextGeneration || !path || typeof path !== "string" || !can(operation)) return;
+      const name = path.split(/[/\\]/).pop() || "";
+      pending.value = { operation, source: entry, target: operation === "upload" ? filesystemChildUri(currentUri.value, name) : entry!.uri, localPath: path, overwrite: false };
+    } catch (cause) {
+      if (!disposed && generation === contextGeneration) error.value = filesystemErrorText(cause);
+    } finally {
+      if (generation === contextGeneration) busy.value = false;
+    }
+  } else pending.value = { operation, source: entry, target: operation === "mkdir" ? "" : entry?.uri || "", overwrite: false };
+}
+
+async function confirmOperation() {
+  const item = pending.value;
+  if (!item || !validOperation.value || !permitted(item.operation, item.source)) return;
+  busy.value = true;
+  operationError.value = "";
+  // Bind all fields before awaiting production approval. A later UI edit cannot change the approved operation.
+  const request = { ...item, target: item.target.trim() };
+  const generation = contextGeneration;
+  const bound = { pluginId: props.pluginId, providerId: props.provider.id, connectionId: props.connectionId };
+  const target = request.operation === "mkdir" ? currentUri.value : request.target;
+  try {
+    const targetUri = request.operation === "mkdir" ? filesystemChildUri(target, request.target) : request.target;
+    const execute = async () => {
+      if (disposed || generation !== contextGeneration || pending.value !== item || !can(request.operation)) throw new Error(t("hostFilesystem.operationUnavailable"));
+      let result: PluginFilesystemMutationResult;
+      const options = { connectionId: bound.connectionId, overwrite: request.overwrite };
+      switch (request.operation) {
+        case "upload":
+        case "download": {
+          const transferRequest = { ...options, uri: request.target, localPath: request.localPath! };
+          const task = request.operation === "upload" ? await api.startPluginFilesystemUpload(bound.pluginId, bound.providerId, transferRequest) : await api.startPluginFilesystemDownload(bound.pluginId, bound.providerId, transferRequest);
+          if (disposed || generation !== contextGeneration) return true;
+          transferRequests.set(task.transferId, request);
+          transfers.update(task, { name: request.source?.name || request.target, direction: request.operation });
+          void transfers.refresh();
+          return true;
+        }
+        case "mkdir":
+          result = await api.createPluginFilesystemDirectory(bound.pluginId, bound.providerId, targetUri, bound.connectionId);
+          break;
+        case "copy":
+          result = await api.copyPluginFilesystemEntry(bound.pluginId, bound.providerId, request.source!.uri, request.target, options);
+          break;
+        case "rename":
+          result = await api.renamePluginFilesystemEntry(bound.pluginId, bound.providerId, request.source!.uri, request.target, options);
+          break;
+        case "delete":
+          result = await api.deletePluginFilesystemEntry(bound.pluginId, bound.providerId, request.source!.uri, { connectionId: bound.connectionId, recursive: false });
+          break;
+      }
+      if (!result.success) throw new Error(result.message || t("hostFilesystem.operationFailed"));
+      return true;
+    };
+    const executed =
+      request.operation === "download"
+        ? await execute()
+        : await executeWithProductionContextGuard({ connection: connection.value, reviewText: `${request.operation.toUpperCase()} ${request.source?.uri || request.localPath || ""} -> ${targetUri}${request.overwrite ? " (OVERWRITE)" : ""}`, source: props.provider.label, execute });
+    if (disposed || generation !== contextGeneration) return;
+    if (executed) {
+      pending.value = undefined;
+      replace.value = false;
+      if (request.operation !== "download") await load(currentUri.value);
+    }
+  } catch (cause) {
+    if (disposed || generation !== contextGeneration) return;
+    const code = filesystemError(cause).code;
+    if ((code === "already_exists" || code === "ALREADY_EXISTS") && request.source?.kind !== "directory" && ["copy", "rename", "upload", "download"].includes(request.operation) && !request.overwrite) replace.value = true;
+    operationError.value = filesystemErrorText(cause);
+  } finally {
+    if (!disposed && generation === contextGeneration) busy.value = false;
+  }
+}
+
+function closeOperation(open: boolean) {
+  if (!open && !busy.value) {
