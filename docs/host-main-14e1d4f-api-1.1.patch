+    #[tokio::test]
+    async fn superseded_and_cloned_handles_cannot_retire_the_current_owner() {
+        use super::{Arc, AtomicU64, Mutex, Ordering, PluginConnectionBinding};
+        let binding = Arc::new(PluginConnectionBinding { lifecycle: Mutex::new(()), generation: AtomicU64::new(1) });
+        let old = sessionless_handle(binding.clone(), 1);
+        let guard = binding.lifecycle.lock().await;
+        let old_disconnect = tokio::spawn(async move { old.disconnect().await });
+        tokio::task::yield_now().await;
+        assert!(!old_disconnect.is_finished());
+        binding.generation.store(2, Ordering::Release);
+        let current = sessionless_handle(binding.clone(), 2);
+        drop(guard);
+        old_disconnect.await.unwrap().unwrap();
+        assert!(current.is_running());
+        let clone = current.clone();
+        current.disconnect().await.unwrap();
+        assert!(!clone.is_running());
+        let generation = binding.generation.load(Ordering::Acquire);
+        clone.disconnect().await.unwrap();
+        assert_eq!(binding.generation.load(Ordering::Acquire), generation);
+    }
