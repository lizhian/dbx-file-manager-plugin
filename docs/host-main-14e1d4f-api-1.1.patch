+            wait_marker(&control, "go").await?;
+            let mut events = state.plugin_host.subscribe_events();
+            let operation = if direction == "upload" { TransferOp::Upload } else { TransferOp::Download };
+            let uri = if direction == "upload" { &remote_target } else { &remote_source };
+            let local = if direction == "upload" { &source } else { &destination };
+            let started =
+                transfer(&state, &config, operation, json!({"uri": uri, "localPath": local, "overwrite": true}))
+                    .await?;
+            if direction == "upload" {
+                let transfer_id = uuid::Uuid::parse_str(&started.transfer_id)?;
+                owned_upload_temporary = Some(format!("{directory}/dbx-upload-{transfer_id}.tmp"));
+            }
+            let running = tokio::time::timeout(Duration::from_secs(10), async {
+                loop {
+                    let status =
+                        transfer(&state, &config, TransferOp::Status, json!({"transferId": started.transfer_id}))
+                            .await?;
+                    require(
+                        matches!(status.state, TransferState::Queued | TransferState::Running),
+                        "Transfer ended before replacement",
+                    )?;
+                    if status.bytes_transferred > 0 && status.state == TransferState::Running {
+                        return Ok::<_, Box<dyn std::error::Error>>(status);
+                    }
+                    tokio::time::sleep(Duration::from_millis(5)).await;
+                }
+            })
+            .await??;
+            require(running.bytes_transferred < SIZE as u64, "Fault injection was not mid-stream")?;
+            marker(&control, "running.json", serde_json::to_value(&running)?)?;
+            wait_marker(&control, "transition").await?;
+            marker(&control, "transition-started.json", json!({"started": true}))?;
+            let replacing_state = state.clone();
+            let upgrade = action == "upgrade";
+            let mut replacing = tokio::spawn(async move {
+                if upgrade {
+                    replacing_state
+                        .install_plugin_package_file(second, PluginInstallPolicy::LocalDevelopment)
+                        .await
+                        .map(|_| ())
+                } else {
+                    replacing_state.rollback_plugin_package(PLUGIN.into()).await.map(|_| ())
+                }
+            });
+            tokio::time::timeout(Duration::from_secs(10), async {
+                while state.pool_handle(&config.id).await.is_some() {
+                    if replacing.is_finished() {
+                        (&mut replacing).await??;
+                        return Err("Replacement finished before draining its pool".into());
+                    }
+                    tokio::time::sleep(Duration::from_millis(5)).await;
+                }
+                Ok::<_, Box<dyn std::error::Error>>(())
+            })
+            .await??;
+            marker(&control, "quiescing.json", json!({"poolDrained": true}))?;
+            replacing.await??;
+            require(state.pool_handle(&config.id).await.is_none(), "Replacement retained old pool")?;
+            require(
+                state.plugin_host.list_active().await.iter().all(|entry| entry.process_id != Some(old_pid)),
+                "Old session retained after replacement",
+            )?;
+            require(
+                state.plugins.find_plugin(PLUGIN)?.ok_or("Replacement missing")?.manifest.version == new_version,
+                "Version did not change",
+            )?;
+            let cancelled = if stop_mode == "forced" {
+                Value::Null
+            } else {
+                let cancelled = tokio::time::timeout(Duration::from_secs(5), async {
+                    loop {
+                        let event = events.recv().await?;
+                        if event.plugin_id == PLUGIN
+                            && event.method == "filesystem/transfer/progress"
+                            && event.params["transferId"] == started.transfer_id
+                            && event.params["state"] == "cancelled"
+                        {
+                            return Ok::<_, Box<dyn std::error::Error>>(event.params);
+                        }
+                    }
+                })
+                .await??;
+                require(cancelled["error"]["data"]["code"] == "cancelled", "Cancellation error lost")?;
+                cancelled
+            };
+            marker(
+                &control,
+                "transition-done.json",
+                json!({"version": new_version, "cancelled": cancelled, "stopMode": stop_mode}),
+            )?;
+            wait_marker(&control, "drained").await?;
+            let saved = state
+                .storage
+                .load_connections()
+                .await?
+                .into_iter()
+                .find(|saved| saved.id == config.id)
+                .ok_or("Saved connection lost")?;
+            require(
+                saved.connection_secrets.get("password").map(String::as_str) == Some("dbx-password"),
+                "Saved secret lost",
+            )?;
+            connect(&state, &saved).await?;
+            let new_pid = state
+                .plugin_host
+                .list_active()
+                .await
+                .into_iter()
+                .find(|entry| entry.plugin_id == PLUGIN)
+                .and_then(|entry| entry.process_id)
+                .ok_or("New process missing")?;
+            require(new_pid != old_pid, "Old process reused after replacement")?;
+            let old_task_error =
+                transfer(&state, &saved, TransferOp::Status, json!({"transferId": started.transfer_id}))
+                    .await
+                    .expect_err("A new Sidecar must not claim ownership of the old transfer");
+            require(
+                old_task_error.data.as_ref().and_then(|data| data["code"].as_str()) == Some("not_found"),
+                "Lost transfer status must retain its structured not_found code",
+            )?;
+            if direction == "upload" {
+                let retained = remote(&state, &saved, Op::Read, json!({"uri": remote_target, "maxBytes": 256})).await?;
+                require(
+                    retained["dataBase64"] == base64::engine::general_purpose::STANDARD.encode(ORIGINAL),
+                    "Remote destination changed during replacement",
+                )?;
+            } else {
+                require(std::fs::read(&destination)? == ORIGINAL, "Local destination changed during replacement")?;
+            }
+            let local_temporary_files = std::fs::read_dir(&files)?
+                .map(|entry| entry.map(|entry| entry.file_name().to_string_lossy().into_owned()))
+                .collect::<Result<Vec<_>, _>>()?
+                .into_iter()
+                .filter(|name| name.starts_with(".dbx-download-"))
+                .collect::<Vec<_>>();
+            let listing = remote(&state, &saved, Op::List, json!({"uri": directory, "limit": 100})).await?;
+            let remote_temporary_files = listing["entries"]
+                .as_array()
+                .ok_or("Missing entries")?
+                .iter()
+                .filter_map(|entry| entry["name"].as_str())
+                .filter(|name| name.starts_with("dbx-upload-"))
+                .collect::<Vec<_>>();
+            marker(
+                &control,
+                "post-stop.json",
+                json!({"stopMode": stop_mode, "oldPid": old_pid, "newPid": new_pid,
+                "originalRetained": true, "secretRetained": true, "oldTaskNotFound": true, "localTemporaryFiles": local_temporary_files,
+                "remoteTemporaryFiles": remote_temporary_files}),
+            )?;
+            require(local_temporary_files.is_empty(), "Download temporary file leaked")?;
+            require(remote_temporary_files.is_empty(), "Upload temporary file leaked")?;
+            complete(&state, &saved, operation, uri, local).await?;
+            if direction == "upload" {
+                complete(&state, &saved, TransferOp::Download, &remote_target, &destination).await?;
+            }
+            require(file_hash(&destination)? == expected_hash, "Replacement retry checksum mismatch")?;
+            marker(
+                &control,
+                "verified.json",
+                json!({"oldPid": old_pid, "newPid": new_pid, "version": new_version, "sha256": expected_hash, "secretRetained": true, "originalRetained": true, "temporaryFilesRemoved": true}),
+            )?;
+            Ok::<_, Box<dyn std::error::Error>>(())
+        };
+        let result = tokio::time::timeout(Duration::from_secs(90), exercise).await;
+        let failure = match &result {
+            Ok(Ok(())) => None,
+            Ok(Err(error)) => Some(error.to_string()),
+            Err(error) => Some(error.to_string()),
+        };
+        if let Some(error) = failure {
+            marker(&control, "failure.json", json!({"error": error}))?;
+        }
+        let cleanup = async {
+            if state.plugins.find_plugin(PLUGIN)?.is_some() {
+                connect(&state, &config).await?;
+                let mut owned_paths = vec![remote_source.clone(), remote_target.clone()];
+                // A killed Sidecar cannot clean its upload; remove only this test's known task path.
+                owned_paths.extend(owned_upload_temporary);
+                owned_paths.push(directory.clone());
+                for uri in owned_paths {
+                    if let Err(error) =
+                        remote(&state, &config, Op::Delete, json!({"uri": uri, "recursive": false})).await
+                    {
+                        if error.data.as_ref().and_then(|data| data["code"].as_str()) != Some("not_found") {
+                            return Err(error.into());
+                        }
+                    }
+                }
+                let absent = match remote(&state, &config, Op::Stat, json!({"uri": directory})).await {
+                    Err(error) => error,
+                    Ok(_) => return Err("Remote fixture remains".into()),
+                };
+                require(
+                    absent.data.as_ref().and_then(|data| data["code"].as_str()) == Some("not_found"),
+                    "Remote fixture remains",
+                )?;
+                state.storage.save_connections(&[]).await?;
+                state.uninstall_plugin_package(PLUGIN.into()).await?;
+            }
+            Ok::<_, Box<dyn std::error::Error>>(())
+        }
+        .await;
+        state.plugin_host.stop_all().await;
+        marker(&control, "cleanup.json", json!({"remoteCleaned": cleanup.is_ok(), "processesStopped": true}))?;
+        cleanup?;
+        result??;
+        Ok(())
+    }
+}
