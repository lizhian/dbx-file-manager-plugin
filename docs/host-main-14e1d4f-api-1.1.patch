+import { describe, expect, it, vi } from "vitest";
+import { PluginHostBridge, pluginSandboxDocument } from "./pluginHostBridge";
+import type { InstalledPlugin, PluginWorkbenchContribution } from "@/types/database";
+
+function plugin(permissions: string[] = []): InstalledPlugin {
+  return {
+    manifest: { id: "sample", name: "Sample", version: "1.0.0", permissions, drivers: [], contributions: [] },
+    compatibility: { compatible: true },
+  };
+}
+
+const workbench: PluginWorkbenchContribution = { type: "workbench", id: "sample.main", label: "Sample" };
+
+describe("PluginHostBridge", () => {
+  it("routes filesystem requests to the validated API but rejects filesystem notifications", async () => {
+    const messages: unknown[] = [];
+    const target = { postMessage: (message: unknown) => messages.push(message) } as unknown as Window;
+    const api = { invoke: vi.fn().mockResolvedValue({ success: true }), notify: vi.fn(), sendBinary: vi.fn(), readAsset: vi.fn() };
+    const bridge = new PluginHostBridge(plugin(), workbench, {}, () => target, api);
+    for (const method of ["backend.invoke", "backend.notify"]) {
+      bridge.handleWindowMessage({
+        source: target,
+        data: {
+          source: "dbx-plugin",
+          version: 1,
+          type: "request",
+          id: method,
+          method,
+          params: { method: "filesystem/delete", params: { providerId: "sample.files", connectionId: "saved", uri: "sample:/file" } },
+        },
+      } as MessageEvent);
+    }
+    await vi.waitFor(() => expect(messages).toHaveLength(2));
+    expect(api.invoke).toHaveBeenCalledOnce();
+    expect(api.notify).not.toHaveBeenCalled();
+    expect(messages).toContainEqual(expect.objectContaining({ id: "backend.notify", error: "This plugin method is reserved for the DBX host" }));
+  });
