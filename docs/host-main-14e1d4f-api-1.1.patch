+    } catch (cause) {
+      if (!filesystemMethodUnavailable(cause)) throw cause;
+    }
+    if (disposed || generation !== capabilityGeneration) return;
+    negotiated.value = details?.capabilities;
+    capabilityDetails.value = details;
+    ready.value = true;
+    if (!can("list")) throw new Error(t("hostFilesystem.operationUnavailable"));
+    await load(currentUri.value);
+    if (can("upload") || can("download")) void transfers.start();
+  } catch (cause) {
+    if (!disposed && generation === capabilityGeneration) {
+      ready.value = false;
+      error.value = filesystemErrorText(cause);
+    }
+  }
+}
+
+onMounted(() => void initialize());
+watch(
+  () => props.initialUri,
+  (uri) => {
+    if (uri && uri !== currentUri.value) void load(uri);
+  },
+);
+watch(readOnly, () => {
+  pending.value = undefined;
+  replace.value = false;
+});
+watch(
+  [() => props.pluginId, () => props.provider.id, () => props.connectionId, () => rootUri.value],
+  () => {
+    contextGeneration++;
+    listGeneration++;
+    clearPreview();
+    pending.value = undefined;
+    busy.value = false;
+    entries.value = [];
+    currentUri.value = props.initialUri || rootUri.value;
+    address.value = currentUri.value;
+    transfers.reset({ pluginId: props.pluginId, providerId: props.provider.id, connectionId: props.connectionId });
+    transferRequests.clear();
+    void initialize();
+  },
+  { flush: "sync" },
+);
+onBeforeUnmount(() => {
+  disposed = true;
+  listGeneration++;
+  previewGeneration++;
+  capabilityGeneration++;
+});
