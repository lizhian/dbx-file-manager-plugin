+            1,
+        );
+        let second = sessionless_handle(
+            Arc::new(PluginConnectionBinding { lifecycle: Mutex::new(()), generation: AtomicU64::new(1) }),
+            1,
+        );
+        first.disconnect().await.unwrap();
+        assert!(!first.is_running());
