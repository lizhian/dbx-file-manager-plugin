+    use std::sync::Arc;
+    use std::time::Duration;
+
+    const PROVIDER: &str = "io.github.lizhian.file-manager.webdav.files";
+    const SIZE: usize = 32 * 1024 * 1024;
+    const ORIGINAL: &[u8] = b"Preserve the original destination during plugin replacement.\n";
+
+    fn marker(control: &Path, name: &str, value: Value) -> TestResult {
+        let temporary = control.join(format!(".{name}.tmp"));
+        std::fs::write(&temporary, serde_json::to_vec(&value)?)?;
+        std::fs::rename(temporary, control.join(name))?;
+        Ok(())
+    }
+
+    async fn wait_marker(control: &Path, name: &str) -> TestResult {
+        tokio::time::timeout(Duration::from_secs(20), async {
+            while !control.join(name).is_file() {
+                tokio::time::sleep(Duration::from_millis(5)).await;
+            }
+        })
+        .await?;
+        Ok(())
+    }
+
+    async fn connect(state: &AppState, config: &ConnectionConfig) -> TestResult {
+        let handle = state.plugin_host.connect_connection(config, &config.host, config.port).await?;
+        state.insert_connection_pool(config.id.clone(), PoolKind::PluginConnection(handle), config).await?;
+        // Web/Tauri publish runtime configuration separately from the pool handle.
+        state.configs.write().await.insert(config.id.clone(), config.clone());
+        Ok(())
+    }
+
+    async fn remote(
+        state: &AppState,
+        config: &ConnectionConfig,
+        operation: Op,
+        params: Value,
+    ) -> Result<Value, crate::plugins::PluginRpcError> {
+        state.invoke_plugin_filesystem(PLUGIN, PROVIDER, Some(&config.id), operation, params).await
+    }
+
+    async fn transfer(
+        state: &AppState,
+        config: &ConnectionConfig,
+        operation: TransferOp,
+        params: Value,
+    ) -> Result<PluginFilesystemTransfer, crate::plugins::PluginRpcError> {
+        state.invoke_plugin_filesystem_transfer(PLUGIN, PROVIDER, &config.id, operation, params).await
+    }
+
+    async fn complete(
+        state: &AppState,
+        config: &ConnectionConfig,
+        operation: TransferOp,
+        uri: &str,
+        local: &Path,
+    ) -> TestResult {
+        let started =
+            transfer(state, config, operation, json!({"uri": uri, "localPath": local, "overwrite": true})).await?;
+        tokio::time::timeout(Duration::from_secs(20), async {
+            loop {
+                let status =
+                    transfer(state, config, TransferOp::Status, json!({"transferId": started.transfer_id})).await?;
+                if status.state == TransferState::Completed {
+                    require(status.bytes_transferred == SIZE as u64, "Retry size mismatch")?;
+                    return Ok::<_, Box<dyn std::error::Error>>(());
+                }
+                require(
+                    matches!(status.state, TransferState::Queued | TransferState::Running),
+                    "Ungated transfer failed",
+                )?;
+                tokio::time::sleep(Duration::from_millis(5)).await;
+            }
+        })
+        .await??;
+        Ok(())
+    }
+
+    fn file_hash(path: &Path) -> Result<String, Box<dyn std::error::Error>> {
+        let mut input = std::fs::File::open(path)?;
+        let mut hash = Sha256::new();
+        let mut buffer = [0u8; 64 * 1024];
+        loop {
+            let count = input.read(&mut buffer)?;
+            if count == 0 {
+                break;
+            }
+            hash.update(&buffer[..count]);
+        }
+        Ok(format!("{:x}", hash.finalize()))
+    }
