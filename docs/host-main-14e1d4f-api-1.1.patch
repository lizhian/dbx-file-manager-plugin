+  const branch = handler.body!.statements.find((statement): statement is ts.IfStatement => ts.isIfStatement(statement) && ts.isCallExpression(statement.expression) && ts.isIdentifier(statement.expression.expression) && statement.expression.expression.text === "isCloseTabShortcut");
+  assert.ok(branch, "The keyboard handler must keep its close-tab shortcut branch");
+  assert.match(branch.thenStatement.getText(script), /await closeActiveSurface\(\)/);
+  assert.doesNotMatch(branch.thenStatement.getText(script), /queryStore\.closeTab\(/);
+
+  // Execute the actual delegation and delegate together, including the pending await.
+  const javascript = ts.transpileModule(`${closeSurface.getText(script)}\nasync function closeShortcut(e) ${branch.thenStatement.getText(script)}`, { compilerOptions: { module: ts.ModuleKind.None, target: ts.ScriptTarget.ES2022 } }).outputText;
+  for (const clearedResults of [true, false]) {
+    const events: string[] = [];
+    let finishClear!: (cleared: boolean) => void;
+    const queryStore = {
+      activeTabId: "query-tab",
+      clearQueryResults: vi.fn(() => {
+        events.push("clear:start");
+        return new Promise<boolean>((resolve) => {
+          finishClear = resolve;
+        });
+      }),
+      closeTab: vi.fn(() => {
+        events.push("close-tab");
+      }),
+    };
+    const dependencies = {
+      queryStore,
+      showSettingsPage: { value: false },
+      showPluginCenter: { value: false },
+      showDriverStore: { value: false },
+      closeSettingsPage: vi.fn(),
+      closePluginCenterPage: vi.fn(),
+      closeDriverStorePage: vi.fn(),
+    };
+    const closeShortcut = new Function(...Object.keys(dependencies), `${javascript}\nreturn closeShortcut;`)(...Object.values(dependencies)) as (event: { preventDefault: () => void }) => Promise<void>;
+    const event = {
+      preventDefault: vi.fn(() => {
+        events.push("prevent-default");
+      }),
+    };
+    let finished = false;
+    const closing = closeShortcut(event).then(() => {
+      finished = true;
+    });
+    for (let turn = 0; turn < 5; turn++) await Promise.resolve();
+    assert.equal(finished, false, "The shortcut must await result clearing");
+    assert.deepEqual(events, ["prevent-default", "clear:start"]);
+    assert.deepEqual(queryStore.clearQueryResults.mock.calls, [["query-tab"]]);
+    assert.equal(queryStore.closeTab.mock.calls.length, 0);
+
+    events.push("clear:complete");
+    finishClear(clearedResults);
+    await closing;
+    assert.deepEqual(events, clearedResults ? ["prevent-default", "clear:start", "clear:complete"] : ["prevent-default", "clear:start", "clear:complete", "close-tab"]);
+    assert.deepEqual(queryStore.closeTab.mock.calls, clearedResults ? [] : [["query-tab"]]);
+    assert.equal(event.preventDefault.mock.calls.length, 1);
+    assert.equal(dependencies.closeSettingsPage.mock.calls.length, 0);
+    assert.equal(dependencies.closePluginCenterPage.mock.calls.length, 0);
+    assert.equal(dependencies.closeDriverStorePage.mock.calls.length, 0);
+  }
 });
 
