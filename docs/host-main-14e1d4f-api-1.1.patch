+    #[test]
+    fn filesystem_rpc_wait_uses_connection_query_budget_including_unlimited() {
+        assert_eq!(filesystem_query_timeout(None), Some(PLUGIN_REQUEST_TIMEOUT));
+        let mut config = config();
+        assert_eq!(filesystem_query_timeout(Some(&config)), Some(Duration::from_secs(60)));
+        config.query_timeout_secs = 0;
+        assert_eq!(filesystem_query_timeout(Some(&config)), None);
+        config.query_timeout_secs = 1;
+        assert_eq!(filesystem_query_timeout(Some(&config)), Some(Duration::from_secs(1)));
+        config.query_timeout_secs = 3_600;
+        assert_eq!(filesystem_query_timeout(Some(&config)), Some(Duration::from_secs(3_600)));
+    }
+
+    #[test]
+    fn requires_saved_matching_plugin_provider_binding() {
+        let manifest = manifest();
+        let mut config = config();
+        assert!(validate_binding(&manifest, "ftp.files", None, false).is_err());
+        assert!(validate_binding(&manifest, "ftp.files", Some(&config), false).is_ok());
+        assert!(validate_binding(&manifest, "other.files", Some(&config), false).is_err());
+        config.plugin_id = Some("other".into());
+        assert!(validate_binding(&manifest, "ftp.files", Some(&config), false).is_err());
+        config.plugin_id = Some("files".into());
+        config.plugin_connection_type = Some("s3".into());
+        assert!(validate_binding(&manifest, "ftp.files", Some(&config), false).is_err());
+        assert!(validate_binding(&PluginManifest::default(), "unbound", None, false).is_ok());
+    }
+
+    #[test]
+    fn read_only_allows_reads_and_blocks_every_remote_mutation() {
+        let mut config = config();
+        config.read_only = true;
+        for capability in known_capabilities() {
+            let result = validate_binding(&manifest(), "ftp.files", Some(&config), is_mutation(capability));
+            assert_eq!(result.is_err(), is_mutation(capability));
+            if let Err(error) = result {
+                assert_eq!(error.data.unwrap()["code"], "read_only");
+            }
+        }
+    }
+
+    #[test]
+    fn accepts_only_canonical_capabilities_and_rejects_unpublished_shapes() {
+        let capabilities = decode_capabilities(
+            json!({"capabilities": ["stat", "read"], "read": true, "write": false, "stat": true, "recursiveCopy": false, "future": true}),
+        )
+        .unwrap();
+        assert_eq!(capabilities.capabilities, vec![Capability::Stat, Capability::Read]);
+        assert_eq!(capabilities.details["recursiveCopy"], false);
+        assert!(decode_capabilities(json!({"read": true})).is_err());
+        assert!(decode_capabilities(json!({"capabilities": ["write"], "write": "true"})).is_err());
+        assert!(decode_capabilities(json!({"capabilities": ["unknown"]})).is_err());
+        assert!(serde_json::from_value::<super::super::PluginFilesystemEntry>(
+            json!({"entry": {"name": "file", "uri": "ftp:/file", "kind": "file"}})
+        )
+        .is_err());
+        assert!(serde_json::from_value::<PluginFilesystemTransfer>(json!({"transferId": "t"})).is_err());
+    }
+
+    #[test]
+    fn capability_fallback_only_accepts_method_not_found_and_never_infers_transfer() {
+        let mut provider = manifest().filesystem_provider("ftp.files").unwrap().unwrap();
+        provider.capabilities = vec![Capability::Read, Capability::Write];
+        let missing = PluginRpcError { code: -32601, message: "Method not found".into(), data: None };
+        let fallback = effective_capabilities(&provider, false, Err(missing)).unwrap();
+        assert_eq!(fallback.capabilities, vec![Capability::Read, Capability::Write, Capability::List]);
+        let timeout = PluginRpcError::host("timeout", "Timed out");
+        assert_eq!(effective_capabilities(&provider, false, Err(timeout.clone())).unwrap_err(), timeout);
+        let caps = effective_capabilities(
+            &provider,
+            true,
+            Ok(json!({
+                "capabilities": ["read", "write", "copy", "upload", "download"],
+                "read": true, "write": true, "copy": true, "upload": true, "download": true,
+                "recursiveDelete": true, "recursiveCopy": true,
+            })),
+        )
+        .unwrap();
+        assert_eq!(caps.capabilities, vec![Capability::Read]);
+        for key in ["write", "copy", "upload", "download", "recursiveDelete", "recursiveCopy"] {
+            assert_eq!(caps.details[key], false);
+        }
+    }
+
+    #[tokio::test]
+    async fn generic_filesystem_mutations_use_saved_policy_not_stale_runtime_config() {
+        let root = tempfile::tempdir().unwrap();
+        let plugin_dir = root.path().join("plugins/files");
+        std::fs::create_dir_all(&plugin_dir).unwrap();
+        std::fs::write(plugin_dir.join("backend"), "unused").unwrap();
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::set_permissions(plugin_dir.join("backend"), std::fs::Permissions::from_mode(0o755)).unwrap();
+        }
+        let mut manifest = manifest();
+        manifest.entrypoints.backend = Some(crate::plugins::PluginBackendEntrypoint {
+            executable: "backend".into(),
+            protocol_versions: vec![1],
+            transport: crate::plugins::PluginBackendTransport::StdioFramed,
+        });
+        std::fs::write(plugin_dir.join("manifest.json"), serde_json::to_vec(&manifest).unwrap()).unwrap();
+        let storage = crate::storage::Storage::open(&root.path().join("storage.db")).await.unwrap();
+        let state = AppState::new_with_plugin_dir_and_app_version(storage, root.path().join("plugins"), "0.6.1");
+        let mut config = config();
+        state.configs.write().await.insert(config.id.clone(), config.clone());
+        state.storage.save_connections(std::slice::from_ref(&config)).await.unwrap();
+        config.read_only = true;
+        state.storage.save_connections(std::slice::from_ref(&config)).await.unwrap();
+        for method in [
+            "filesystem/write",
+            "filesystem/createDirectory",
+            "filesystem/delete",
+            "filesystem/rename",
+            "filesystem/copy",
+        ] {
+            let error = state
+                .invoke_plugin_generic::<Value>(
+                    "files",
+                    method,
+                    json!({"providerId": "ftp.files", "connectionId": "saved"}),
+                    None,
+                )
+                .await
+                .unwrap_err();
+            assert_eq!(error.data.unwrap()["code"], "read_only", "{method}");
+        }
+        for params in
+            [json!({"providerId": "ftp.files"}), json!({"providerId": "ftp.files", "connectionId": "unknown"})]
+        {
+            assert!(state.invoke_plugin_generic::<Value>("files", "filesystem/list", params, None).await.is_err());
+        }
+        assert_eq!(
+            state
+                .invoke_plugin_generic::<Value>("files", "filesystem/custom", json!({}), None)
+                .await
+                .unwrap_err()
+                .data
+                .unwrap()["code"],
+            "unsupported"
+        );
+        assert!(state.plugin_host.list_active().await.is_empty());
+        config.query_timeout_secs = 0;
+        state.storage.save_connections(std::slice::from_ref(&config)).await.unwrap();
+        assert_eq!(
+            state.plugin_filesystem_context("files", "ftp.files", Some("saved"), false).await.unwrap().timeout,
