+    #[test]
+    fn validates_transfer_scope_and_drops_local_paths() {
+        let transfer: PluginFilesystemTransfer = serde_json::from_value(json!({
+            "transferId": "t", "state": "running", "bytesTransferred": 4, "totalBytes": 8,
+            "providerId": "ftp.files", "connectionId": "saved", "localPath": "/private/file",
+            "direction": "upload", "uri": "ftp:/file",
+        }))
+        .unwrap();
+        assert!(serde_json::to_value(&transfer).unwrap().get("localPath").is_none());
+        assert!(validate_transfer_binding(&transfer, "ftp.files", "saved").is_ok());
+        assert!(validate_transfer_binding(&transfer, "ftp.files", "other").is_err());
+        let mut missing_scope = transfer.clone();
+        missing_scope.provider_id = None;
+        assert!(validate_transfer_binding(&missing_scope, "ftp.files", "saved").is_err());
