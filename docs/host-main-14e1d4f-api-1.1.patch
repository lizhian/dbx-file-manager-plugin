+import { createPinia, setActivePinia } from "pinia";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { ConnectionConfig } from "@/types/database";
+
+vi.mock("@/lib/backend/tauriRuntime", () => ({ isTauriRuntime: () => false }));
+vi.mock("@/lib/backend/api", () => ({
+  saveSidebarLayout: vi.fn().mockResolvedValue(undefined),
+  saveConnections: vi.fn().mockResolvedValue(undefined),
+}));
+
+describe("plugin connection normalization", () => {
+  beforeEach(() => {
+    const data = new Map<string, string>();
+    vi.stubGlobal("localStorage", {
+      getItem: (key: string) => data.get(key) ?? null,
+      setItem: (key: string, value: string) => data.set(key, value),
+      removeItem: (key: string) => data.delete(key),
+    });
+    setActivePinia(createPinia());
+  });
+  afterEach(() => vi.unstubAllGlobals());
+
+  it.each([undefined, null])("does not invent driver defaults when persisted plugin fields are %s", async (value) => {
+    const { useConnectionStore } = await import("@/stores/connectionStore");
+    const store = useConnectionStore();
+    const config = {
+      id: "plugin",
+      name: "Plugin",
+      db_type: "plugin",
+      host: "127.0.0.1",
+      port: 2121,
+      username: "fixture",
+      password: "",
+      save_password: true,
+      plugin_id: "sample.files",
+      plugin_connection_provider: "sample.files.ftp",
+      plugin_connection_type: "ftp",
+      driver_profile: value,
+      driver_label: value,
+      url_params: value,
+    } as unknown as ConnectionConfig;
+    store.addEphemeralConnection(config);
+    const normalized = store.getConfig(config.id)!;
+    expect(normalized.driver_profile).toBe(value);
+    expect(normalized.driver_label).toBe(value);
+    expect(normalized.url_params).toBe(value);
+    expect(config.driver_profile).toBe(value);
+  });
+
+  it("preserves explicitly supplied plugin fields and native database defaults", async () => {
+    const { useConnectionStore } = await import("@/stores/connectionStore");
+    const store = useConnectionStore();
+    store.addEphemeralConnection({ id: "plugin", name: "Plugin", db_type: "plugin", host: "", port: 0, username: "", password: "", driver_profile: "custom", driver_label: "Custom", url_params: "mode=custom" } as ConnectionConfig);
+    expect(store.getConfig("plugin")).toMatchObject({ driver_profile: "custom", driver_label: "Custom", url_params: "mode=custom" });
+    store.addEphemeralConnection({ id: "pg", name: "PG", db_type: "postgres", host: "127.0.0.1", port: 5432, username: "", password: "" } as ConnectionConfig);
+    expect(store.getConfig("pg")).toMatchObject({ driver_profile: "postgres", driver_label: "PostgreSQL", url_params: "" });
+  });
+});
