+        assert!(prepare_remote_request(&provider, PluginFilesystemOperation::List, &mut request).is_err());
+        let mut request = json!({"uri": "ftp:/a", "maxBytes": u64::MAX});
+        prepare_remote_request(&provider, PluginFilesystemOperation::Read, &mut request).unwrap();
+        assert_eq!(request["maxBytes"], MAX_PLUGIN_FILESYSTEM_PREVIEW_BYTES);
