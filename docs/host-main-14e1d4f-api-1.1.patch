+
+    #[test]
+    fn local_paths_must_be_absolute_regular_files_without_traversal() {
+        assert!(validate_local_path("relative", false).is_err());
+        assert!(validate_local_path("/tmp/../secret", false).is_err());
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().canonicalize().unwrap();
+        assert!(validate_local_path(root.to_str().unwrap(), false).is_err());
+        let file = root.join("file");
+        assert!(validate_local_path(file.to_str().unwrap(), true).is_err());
+        assert!(validate_local_path(file.to_str().unwrap(), false).is_ok());
+        std::fs::write(&file, "sample").unwrap();
+        assert!(validate_local_path(file.to_str().unwrap(), true).is_ok());
+        #[cfg(unix)]
+        {
+            let link = root.join("link");
+            std::os::unix::fs::symlink(&file, &link).unwrap();
+            assert!(validate_local_path(link.to_str().unwrap(), true).is_err());
+            assert!(validate_local_path(link.to_str().unwrap(), false).is_err());
+        }
+    }
