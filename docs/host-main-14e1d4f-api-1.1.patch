+pub async fn save_plugin_trusted_key(
+    State(state): State<Arc<WebState>>,
+    Json(request): Json<PluginTrustedKeyRequest>,
+) -> Result<Json<Vec<PluginTrustedKey>>, AppError> {
+    let root_dir = state.app.plugins.root_dir().to_path_buf();
