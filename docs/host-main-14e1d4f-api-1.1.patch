+      const result = document.querySelector("#result");
+      const button = document.querySelector("#context");
+      const copy = {
+        en: { eyebrow: "DBX frontend plugin", description: "This universal sandboxed workbench runs without a native sidecar.", button: "Show host context", ready: "Ready", error: "Error" },
+        zh: { eyebrow: "DBX 前端插件", description: "这个通用沙箱工作台不需要原生 Sidecar。", button: "查看宿主上下文", ready: "已就绪", error: "错误" }
+      };
+      let text = copy.en;
+      window.dbxPlugin.ready.then((context) => {
+        text = window.dbxPlugin.locale.toLowerCase().startsWith("zh") ? copy.zh : copy.en;
+        document.querySelector("#eyebrow").textContent = text.eyebrow;
+        document.querySelector("#description").textContent = text.description;
+        button.textContent = text.button;
+        result.textContent = context && Object.keys(context).length ? JSON.stringify(context, null, 2) : text.ready;
+      });
+      button.addEventListener("click", async () => {
+        button.disabled = true;
