+pub fn ensure_generic_plugin_method(method: &str) -> Result<(), super::PluginRpcError> {
+    if method.starts_with("filesystem/") || method.starts_with("connection/") || method == "plugin/initialize" {
+        return Err(super::PluginRpcError::host("host_only_method", "This method requires a dedicated host API"));
+    }
+    Ok(())
+}
