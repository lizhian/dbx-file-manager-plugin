+#[cfg(unix)]
+mod active_transfer_lifecycle {
+    use super::{require, TestResult, PLUGIN};
+    use crate::connection::{AppState, PoolKind};
+    use crate::models::connection::ConnectionConfig;
+    use crate::plugins::{
+        PluginFilesystemOperation as Op, PluginFilesystemTransfer, PluginFilesystemTransferOperation as TransferOp,
+        PluginFilesystemTransferState as TransferState, PluginInstallPolicy,
+    };
+    use crate::storage::Storage;
+    use base64::Engine;
+    use serde_json::{json, Value};
+    use sha2::{Digest, Sha256};
+    use std::io::{Read, Write};
