+// @vitest-environment happy-dom
+import { createApp, defineComponent, h, nextTick, reactive, type App } from "vue";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({ list: vi.fn(), active: vi.fn(), persist: vi.fn(), store: {} as { activeTabId: string; tabs: { id: string; connectionId: string; pluginFilesystem: { pluginId: string; providerId: string; currentUri: string } }[]; flushPendingPersist: () => Promise<void> } }));
+vi.mock("@/lib/backend/api", () => ({ listPlugins: mocks.list, listActivePlugins: mocks.active }));
+vi.mock("@/stores/queryStore", () => ({ useQueryStore: () => mocks.store }));
+vi.mock("vue-i18n", () => ({ useI18n: () => ({ t: (key: string) => key, locale: { value: "en" } }) }));
+vi.mock("@/lib/plugins/frontendPlugin", () => ({ createFrontendPluginRegistry: (entries: unknown[]) => ({ listFilesystemProviders: () => entries }) }));
+vi.mock("@/components/ui/button", () => ({
+  Button: defineComponent({
+    setup(_, { attrs, slots }) {
+      return () => h("button", attrs, slots.default?.());
+    },
+  }),
+}));
+vi.mock("./PluginFileManager.vue", () => ({
+  default: defineComponent({
+    props: { initialUri: String },
+    emits: ["navigate"],
+    setup(props, { emit }) {
+      return () => h("button", { "data-manager": true, "data-uri": props.initialUri, onClick: () => emit("navigate", "sample:/next/") }, "navigate");
+    },
+  }),
+}));
+import PluginFilesystemTab from "./PluginFilesystemTab.vue";
+
+let app: App | undefined;
+let root: HTMLDivElement;
+async function flush() {
+  for (let i = 0; i < 20; i++) await Promise.resolve();
+  await nextTick();
+}
+afterEach(() => {
+  app?.unmount();
+  app = undefined;
+  root?.remove();
+  vi.useRealTimers();
+  vi.clearAllMocks();
+});
+
+async function mount(activeTabId = "original") {
+  mocks.store = reactive({
+    activeTabId,
+    tabs: [
+      { id: "original", connectionId: "c", pluginFilesystem: { pluginId: "plugin", providerId: "files", currentUri: "sample:/saved/" } },
+      { id: "other", connectionId: "c", pluginFilesystem: { pluginId: "plugin", providerId: "files", currentUri: "sample:/other/" } },
+    ],
+    flushPendingPersist: mocks.persist,
+  });
+  mocks.persist.mockResolvedValue(undefined);
+  mocks.active.mockResolvedValue([{ pluginId: "plugin", state: "running" }]);
+  mocks.list.mockResolvedValue([{ plugin: { manifest: { id: "plugin", version: "1" } }, contribution: { id: "files", schemes: ["sample"], capabilities: ["read"] } }]);
+  root = document.createElement("div");
+  document.body.append(root);
+  app = createApp({ render: () => h(PluginFilesystemTab, { tabId: "original", pluginId: "plugin", providerId: "files", connectionId: "c", initialUri: "sample:/saved/" }) });
+  app.mount(root);
+  await flush();
+}
+
+describe("persisted filesystem tabs", () => {
+  it("persists to the owning pane even when another matching tab is focused at mount", async () => {
+    await mount("other");
+    root.querySelector<HTMLButtonElement>("[data-manager]")!.click();
+    await flush();
+    expect(mocks.store.tabs[0].pluginFilesystem.currentUri).toBe("sample:/next/");
+    expect(mocks.store.tabs[1].pluginFilesystem.currentUri).toBe("sample:/other/");
+  });
+  it("restores the URI and flushes navigation into its own tab, not the newly active tab", async () => {
+    await mount();
+    expect(root.querySelector("[data-manager]")!.getAttribute("data-uri")).toBe("sample:/saved/");
+    mocks.store.activeTabId = "other";
+    root.querySelector<HTMLButtonElement>("[data-manager]")!.click();
+    await flush();
+    expect(mocks.store.tabs[0].pluginFilesystem.currentUri).toBe("sample:/next/");
+    expect(mocks.store.tabs[1].pluginFilesystem.currentUri).toBe("sample:/other/");
+    expect(mocks.persist).toHaveBeenCalledTimes(1);
+  });
+  it("removes an unavailable provider and clears lifecycle polling on unmount", async () => {
+    vi.useFakeTimers();
+    await mount();
+    mocks.list.mockResolvedValue([]);
+    await vi.advanceTimersByTimeAsync(10000);
+    await flush();
+    expect(root.querySelector("[data-manager]")).toBeNull();
+    expect(root.textContent).toContain("pluginPlatform.filesystemUnavailable");
+    app!.unmount();
+    app = undefined;
+    const calls = mocks.list.mock.calls.length;
+    await vi.advanceTimersByTimeAsync(20000);
+    expect(mocks.list).toHaveBeenCalledTimes(calls);
+  });
+  it("surfaces a stopped backend and retries the native manager after explicit refresh", async () => {
+    vi.useFakeTimers();
+    await mount();
+    mocks.active.mockResolvedValue([{ pluginId: "plugin", state: "exited" }]);
+    await vi.advanceTimersByTimeAsync(10000);
+    await flush();
+    expect(root.querySelector("[data-manager]")).toBeNull();
+    expect(root.textContent).toContain("hostFilesystem.processUnavailable");
+    root.querySelector<HTMLButtonElement>("button")!.click();
+    await flush();
+    expect(root.querySelector("[data-manager]")).not.toBeNull();
+  });
+});
diff --git a/apps/desktop/src/components/plugins/PluginFilesystemTab.vue b/apps/desktop/src/components/plugins/PluginFilesystemTab.vue
new file mode 100644
index 0000000000000000000000000000000000000000..46a1ab57ee018feaeb3b68ace82ae55531739c0c
--- /dev/null
+++ b/apps/desktop/src/components/plugins/PluginFilesystemTab.vue
@@ -0,0 +1,123 @@
+<script setup lang="ts">
+import { computed, onBeforeUnmount, onMounted, ref, watch } from "vue";
+import { AlertTriangle, Loader2 } from "@lucide/vue";
+import PluginFileManager from "@/components/plugins/PluginFileManager.vue";
+import * as api from "@/lib/backend/api";
+import { createFrontendPluginRegistry } from "@/lib/plugins/frontendPlugin";
+import type { InstalledPlugin } from "@/types/database";
+import { useI18n } from "vue-i18n";
+import { Button } from "@/components/ui/button";
+import { useQueryStore } from "@/stores/queryStore";
+import { filesystemErrorText } from "@/lib/plugins/hostFilesystem";
+
+const props = defineProps<{
+  tabId: string;
+  pluginId: string;
+  providerId: string;
+  connectionId?: string;
+  rootUri?: string;
+  initialUri?: string;
+}>();
+
+const { t, locale: appLocale } = useI18n();
+const queryStore = useQueryStore();
+let disposed = false;
+let timer: ReturnType<typeof setInterval> | undefined;
+let checking = false;
+
+const plugins = ref<InstalledPlugin[]>([]);
+const loading = ref(true);
+const error = ref("");
+const persistenceError = ref("");
+let loadGeneration = 0;
+const entry = computed(() =>
+  createFrontendPluginRegistry(plugins.value, appLocale.value)
+    .listFilesystemProviders()
+    .find((candidate) => candidate.plugin.manifest.id === props.pluginId && candidate.contribution.id === props.providerId),
+);
+const provider = computed(() => (entry.value ? { ...entry.value.contribution, root_uri: props.rootUri || entry.value.contribution.root_uri } : undefined));
+
+async function persistUri(uri: string) {
+  // Multiple panes can mount at once; global focus does not identify this tab.
+  const tab = queryStore.tabs.find((candidate) => candidate.id === props.tabId);
+  if (tab?.pluginFilesystem?.pluginId !== props.pluginId || tab.pluginFilesystem.providerId !== props.providerId || tab.connectionId !== (props.connectionId || "")) return;
+  if (tab.pluginFilesystem.currentUri === uri && !persistenceError.value) return;
+  tab.pluginFilesystem = { ...tab.pluginFilesystem, currentUri: uri };
+  try {
+    await queryStore.flushPendingPersist();
+    if (!disposed) persistenceError.value = "";
+  } catch (cause) {
+    if (!disposed) persistenceError.value = filesystemErrorText(cause);
+  }
+}
+
+async function load(background = false) {
+  if (checking || disposed) return;
+  checking = true;
+  const generation = ++loadGeneration;
+  if (!background) loading.value = true;
+  try {
+    const installed = await api.listPlugins();
+    if (disposed || generation !== loadGeneration) return;
+    plugins.value = installed;
+    if (!entry.value) throw new Error(t("pluginPlatform.filesystemUnavailable", { pluginId: props.pluginId, providerId: props.providerId }));
+    if (background) {
+      const sessions = await api.listActivePlugins();
+      if (disposed || generation !== loadGeneration) return;
+      const session = sessions.find((candidate) => candidate.pluginId === props.pluginId);
+      if (session && ["stopping", "stopped", "exited"].includes(session.state)) throw new Error(t("hostFilesystem.processUnavailable"));
+    }
+    error.value = "";
+  } catch (cause) {
+    if (disposed || generation !== loadGeneration) return;
+    error.value = filesystemErrorText(cause);
+  } finally {
+    if (generation === loadGeneration) checking = false;
+    if (!disposed && generation === loadGeneration) loading.value = false;
+  }
+}
+
+onMounted(() => {
+  void load();
+  timer = setInterval(() => void load(true), 10000);
+});
+onBeforeUnmount(() => {
+  disposed = true;
+  loadGeneration++;
+  clearInterval(timer);
+});
+watch(
+  () => [props.pluginId, props.providerId, props.connectionId],
+  () => {
+    loadGeneration++;
+    checking = false;
+    plugins.value = [];
+    void load();
+  },
+  { flush: "sync" },
+);
+</script>
+
+<template>
+  <div class="flex size-full min-h-0 min-w-0 flex-col">
+    <p v-if="persistenceError" role="alert" class="shrink-0 border-b px-3 py-2 text-xs text-destructive">{{ persistenceError }}</p>
+    <div v-if="loading" class="m-auto flex items-center text-sm text-muted-foreground"><Loader2 class="mr-2 size-4 animate-spin" />{{ t("pluginPlatform.loadingFilesystem") }}</div>
+    <div v-else-if="error || !provider" class="m-auto flex max-w-lg items-start gap-3 rounded-lg border border-destructive/40 bg-destructive/5 p-4 text-sm text-destructive">
+      <AlertTriangle class="mt-0.5 size-4 shrink-0" />
+      <div>
+        <p>{{ error || t("pluginPlatform.filesystemUnavailableFallback") }}</p>
+        <Button class="mt-3" size="sm" variant="outline" @click="load()">{{ t("pluginPlatform.refresh") }}</Button>
+      </div>
+    </div>
+    <PluginFileManager
+      v-else
+      :key="`${pluginId}:${providerId}:${connectionId || ''}:${provider.root_uri}:${entry?.plugin.manifest.version}:${provider.capabilities?.join(',')}`"
+      class="min-h-0 flex-1"
+      :plugin-id="pluginId"
+      :provider="provider"
+      :connection-id="connectionId"
+      :initial-uri="initialUri"
+      @navigate="persistUri"
+    />
+  </div>
+</template>
