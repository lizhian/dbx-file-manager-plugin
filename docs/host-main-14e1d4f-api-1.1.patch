+    fn normalizes_safe_request_defaults_and_validates_both_copy_uris() {
+        let provider = manifest().filesystem_provider("ftp.files").unwrap().unwrap();
+        let mut request = json!({"sourceUri": "ftp:/a", "targetUri": "ftp:/b"});
+        prepare_remote_request(&provider, PluginFilesystemOperation::Copy, &mut request).unwrap();
+        assert_eq!(request["overwrite"], false);
+        request["targetUri"] = json!("file:/private");
