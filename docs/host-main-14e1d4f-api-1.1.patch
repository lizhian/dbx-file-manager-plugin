+    replace.value = false;
+  }
+}
+function replaceTransfer(transferId: string) {
+  const request = transferRequests.get(transferId);
+  if (!request || busy.value || !replaceableTransfers.value.has(transferId)) return;
+  pending.value = { ...request };
+  replace.value = true;
+  operationError.value = "";
+}
+async function revealTransfer(transferId: string) {
+  const path = transferRequests.get(transferId)?.localPath;
+  if (!path || !revealableTransfers.value.has(transferId)) return;
+  try {
+    await api.revealPathInFileManager(path);
+  } catch (cause) {
+    if (!disposed) transferError.value = filesystemErrorText(cause);
+  }
+}
+function menu(entry: PluginFilesystemEntry): ContextMenuItem[] {
+  const items: ContextMenuItem[] = [];
+  if ((entry.kind === "directory" && can("list")) || (entry.kind === "file" && can("read"))) items.push({ label: t("hostFilesystem.open"), icon: entry.kind === "directory" ? FolderOpen : File, action: () => void activate(entry) });
+  for (const [operation, icon] of [
+    ["copy", Copy],
+    ["rename", FilePenLine],
+    ["download", Download],
+    ["delete", Trash2],
+  ] as const) {
+    if (can(operation)) items.push({ label: t(`hostFilesystem.${operation}`), icon, disabled: !permitted(operation, entry), action: () => void begin(operation, entry), variant: operation === "delete" ? "destructive" : undefined });
+  }
+  items.push({
+    label: t("hostFilesystem.copyUri"),
+    icon: Copy,
+    action: () =>
+      void copyToClipboard(entry.uri).catch((cause) => {
+        error.value = filesystemErrorText(cause);
+      }),
+  });
+  return items;
+}
+
+async function initialize() {
+  const generation = ++capabilityGeneration;
+  const bound = { pluginId: props.pluginId, providerId: props.provider.id, connectionId: props.connectionId };
+  listGeneration++;
+  clearPreview();
+  ready.value = false;
+  error.value = "";
+  try {
+    if (bound.connectionId) {
+      await connectionStore.initFromDisk();
+      if (disposed || generation !== capabilityGeneration) return;
+      await connectionStore.ensureConnected(bound.connectionId, { activate: false, verifyHealth: true });
+      if (disposed || generation !== capabilityGeneration) return;
+    }
+    let details: PluginFilesystemCapabilities | undefined;
+    try {
+      details = await api.getPluginFilesystemCapabilities(bound.pluginId, bound.providerId, bound.connectionId);
