diff --git a/crates/dbx-core/examples/file_manager_desktop_fixture.rs b/crates/dbx-core/examples/file_manager_desktop_fixture.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a5da660bf7de5a4e81c9043cb1a1311a255b99dd
--- /dev/null
+++ b/crates/dbx-core/examples/file_manager_desktop_fixture.rs
@@ -0,0 +1,213 @@
+//! Disposable native-UI fixtures. Never reads or imports an existing DBX profile.
+use std::path::{Path, PathBuf};
+
+use base64::Engine;
+use dbx_core::connection::AppState;
+use dbx_core::models::connection::ConnectionConfig;
+use dbx_core::plugins::{PluginFilesystemOperation as Op, PluginInstallPolicy, PluginPackageInstaller};
+use dbx_core::storage::Storage;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+
+const PLUGIN: &str = "io.github.lizhian.file-manager";
+const PROVIDER: &str = "io.github.lizhian.file-manager.ftp.files";
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Fixture {
+    run_id: uuid::Uuid,
+}
+
+impl Fixture {
+    fn directory(&self) -> String {
+        format!("dbx-native-{}", self.run_id)
+    }
+
+    fn config(&self, parent: bool, read_only: bool) -> Result<ConnectionConfig> {
+        Ok(serde_json::from_value(json!({
+            "id": self.directory(), "name": "Native FTP acceptance", "db_type": "plugin",
+            "host": "127.0.0.1", "port": 2121, "username": "dbx", "password": "",
+            "save_password": true, "read_only": read_only,
+            "plugin_id": PLUGIN, "plugin_connection_provider": "io.github.lizhian.file-manager.ftp",
+            "plugin_connection_type": "ftp",
+            "external_config": {"root": if parent { "/ftp/dbx/".to_string() } else { format!("/ftp/dbx/{}/", self.directory()) }},
+            "connection_secrets": {"password": "dbx-password"}
+        }))?)
+    }
+}
+
+fn payload() -> Vec<u8> {
+    b"DBX native file transfer acceptance\n".repeat(4096)
+}
+
+async fn remote(state: &AppState, config: &ConnectionConfig, operation: Op, params: Value) -> Result<Value> {
+    Ok(state.invoke_plugin_filesystem(PLUGIN, PROVIDER, Some(&config.id), operation, params).await?)
+}
+
+async fn prepare(package: PathBuf) -> Result<()> {
+    let root = tempfile::Builder::new().prefix("dbx-native-profile-").tempdir()?.keep().canonicalize()?;
+    let fixture = Fixture { run_id: uuid::Uuid::new_v4() };
+    std::fs::write(root.join("fixture.json"), serde_json::to_vec_pretty(&fixture)?)?;
+    std::fs::create_dir(root.join("files"))?;
+    std::fs::write(root.join("files/upload.txt"), payload())?;
+    let installer = PluginPackageInstaller::new(root.join("plugins"), "0.6.5")?;
+    let installed = installer.install_file(&package, PluginInstallPolicy::LocalDevelopment)?;
+    if installed.plugin.manifest.id != PLUGIN {
+        return Err("Unexpected plugin ID".into());
+    }
+    let storage = Storage::open(&root.join("dbx.db")).await?;
+    let state = AppState::new_with_plugin_dir_and_app_version(storage, root.join("plugins"), "0.6.5");
+    let config = fixture.config(true, false)?;
+    state.storage.save_connections(std::slice::from_ref(&config)).await?;
+    let seeded = async {
+        state.plugin_host.connect_connection(&config, &config.host, config.port).await?;
+        let directory = format!("ftp:/{}", fixture.directory());
+        remote(&state, &config, Op::CreateDirectory, json!({"uri": directory})).await?;
+        remote(
+            &state,
+            &config,
+            Op::Write,
+            json!({"uri": format!("{directory}/download-source.txt"), "dataBase64": base64::engine::general_purpose::STANDARD.encode(payload()), "create": true, "overwrite": false}),
+        ).await?;
+        state.storage.save_connections(&[fixture.config(false, false)?]).await?;
+        Ok::<_, Box<dyn std::error::Error>>(())
+    }.await;
+    state.plugin_host.stop_all().await;
+    println!("Fixture profile: {}", root.display());
+    seeded?;
+    println!("Expected file: {} bytes; SHA-256 {:x}", payload().len(), Sha256::digest(payload()));
+    println!("Native downloads must target files/download.txt; uploads must select files/upload.txt.");
+    Ok(())
+}
+
+fn load_fixture(root: &Path) -> Result<Fixture> {
+    if std::fs::symlink_metadata(root)?.file_type().is_symlink()
+        || !root.file_name().and_then(|name| name.to_str()).is_some_and(|name| name.starts_with("dbx-native-profile-"))
+    {
+        return Err("Expected the dedicated generated native fixture profile".into());
+    }
+    Ok(serde_json::from_slice(&std::fs::read(root.join("fixture.json"))?)?)
+}
+
+async fn inspect(root: PathBuf, action: &str) -> Result<()> {
+    let fixture = load_fixture(&root)?;
+    if action == "verify-download" {
+        let bytes = std::fs::read(root.join("files/download.txt"))?;
+        if bytes != payload() {
+            return Err("Native download differs from the fixture payload".into());
+        }
+        println!("PASS native download: {} bytes; SHA-256 {:x}", bytes.len(), Sha256::digest(&bytes));
+        return Ok(());
+    }
+    if action != "verify-upload" && action != "verify-seed" && action != "cleanup" {
+        return Err("Expected prepare, verify-download, verify-upload, verify-seed or cleanup".into());
+    }
+    // Verification uses a separate storage file, never changes a running desktop's profile.
+    let temporary = tempfile::tempdir()?;
+    let storage = Storage::open(&temporary.path().join("verify.db")).await?;
+    let state = AppState::new_with_plugin_dir_and_app_version(storage, root.join("plugins"), "0.6.5");
+    let config = fixture.config(action == "cleanup", action != "cleanup")?;
+    state.storage.save_connections(std::slice::from_ref(&config)).await?;
+    let result = async {
+        state.plugin_host.connect_connection(&config, &config.host, config.port).await?;
+        if action != "cleanup" {
+            let uri = if action == "verify-seed" { "ftp:/download-source.txt" } else { "ftp:/upload.txt" };
+            let result =
+                remote(&state, &config, Op::Read, json!({"uri": uri, "maxBytes": payload().len() + 1})).await?;
+            let bytes = base64::engine::general_purpose::STANDARD
+                .decode(result["dataBase64"].as_str().ok_or("Missing data")?)?;
+            if bytes != payload() || result["truncated"] != false {
+                return Err("Remote file differs from the fixture payload".into());
+            }
+            println!("PASS {action}: {} bytes; SHA-256 {:x}", bytes.len(), Sha256::digest(&bytes));
+        } else {
+            for suffix in ["/download-source.txt", "/upload.txt", ""] {
+                let uri = format!("ftp:/{}{suffix}", fixture.directory());
+                let result = state
+                    .invoke_plugin_filesystem::<Value>(
+                        PLUGIN,
+                        PROVIDER,
+                        Some(&config.id),
+                        Op::Delete,
+                        json!({"uri": uri, "recursive": false}),
+                    )
+                    .await;
+                if let Err(error) = result {
+                    if error.data.as_ref().and_then(|data| data["code"].as_str()) != Some("not_found") {
+                        return Err(error.into());
+                    }
+                }
+            }
+            let remaining = state
+                .invoke_plugin_filesystem::<Value>(
+                    PLUGIN,
+                    PROVIDER,
+                    Some(&config.id),
+                    Op::Stat,
+                    json!({"uri": format!("ftp:/{}", fixture.directory())}),
+                )
+                .await;
+            if remaining.err().and_then(|error| error.data).is_none_or(|data| data["code"] != "not_found") {
+                return Err("Fixture directory absence was not verified after cleanup".into());
+            }
+            println!("PASS cleanup: named UUID-scoped fixture files and their empty directory are absent");
+        }
+        Ok::<_, Box<dyn std::error::Error>>(())
+    }
+    .await;
+    state.plugin_host.stop_all().await;
+    result
+}
+
+#[tokio::main]
+async fn main() -> Result<()> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    if args.len() != 2 {
+        return Err("Usage: file_manager_desktop_fixture prepare <candidate.dbxp> | verify-download|verify-upload|verify-seed|cleanup <generated-profile>".into());
+    }
+    if args[0] == "prepare" {
+        prepare(PathBuf::from(&args[1])).await
+    } else {
+        inspect(PathBuf::from(&args[1]), &args[0]).await
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn config_is_limited_to_loopback_and_a_uuid_scoped_root() {
+        let fixture = Fixture { run_id: uuid::Uuid::nil() };
+        let config = fixture.config(false, true).unwrap();
+        assert_eq!(config.host, "127.0.0.1");
+        assert_eq!(config.port, 2121);
+        assert!(config.read_only);
+        assert_eq!(config.id, fixture.directory());
+        assert_eq!(config.external_config.unwrap()["root"], format!("/ftp/dbx/{}/", fixture.directory()));
+        assert_eq!(fixture.config(true, false).unwrap().external_config.unwrap()["root"], "/ftp/dbx/");
+    }
+
+    #[test]
+    fn fixture_marker_must_be_explicit_and_valid() {
+        let ordinary = tempfile::tempdir().unwrap();
+        assert!(load_fixture(ordinary.path()).is_err());
+        let root = tempfile::Builder::new().prefix("dbx-native-profile-").tempdir().unwrap();
+        let fixture = Fixture { run_id: uuid::Uuid::new_v4() };
+        std::fs::write(root.path().join("fixture.json"), serde_json::to_vec(&fixture).unwrap()).unwrap();
+        assert_eq!(load_fixture(root.path()).unwrap().run_id, fixture.run_id);
+        std::fs::write(root.path().join("fixture.json"), br#"{"run_id":"invalid"}"#).unwrap();
+        assert!(load_fixture(root.path()).is_err());
+    }
+
+    #[test]
+    fn payload_is_stable_for_independent_ui_verification() {
+        assert_eq!(payload().len(), 147456);
+        assert_eq!(
+            format!("{:x}", Sha256::digest(payload())),
+            "817ecc1e00aa5730d600173a45336198952b6eb5ed2838ee8f83c4d9bcc2b83e"
+        );
+    }
+}
diff --git a/crates/dbx-core/src/plugins/lifecycle.rs b/crates/dbx-core/src/plugins/lifecycle.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3eb7f351efd12d40738b9ae6437720e8711369f3
--- /dev/null
+++ b/crates/dbx-core/src/plugins/lifecycle.rs
@@ -0,0 +1,116 @@
+//! The installer owns validation/publication; AppState owns runtime quiescence.
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use crate::connection::AppState;
+use crate::models::connection::DatabaseType;
+
+use super::host::PluginLifecycleGuard;
+use super::{
+    PluginInstallPolicy, PluginInstallResult, PluginManifest, PluginMarketplace, PluginMarketplaceInstallRequest,
+    PluginPackageInstaller, PluginRollbackResult,
+};
+
+impl AppState {
+    fn plugin_installer(&self) -> Result<PluginPackageInstaller, String> {
+        PluginPackageInstaller::new(self.plugins.root_dir().to_path_buf(), self.plugins.app_version().to_string())
+    }
+
+    fn plugin_install_barrier(
+        self: &Arc<Self>,
+    ) -> impl FnOnce(&PluginManifest) -> Result<PluginLifecycleGuard, String> + Send + 'static {
+        let state = self.clone();
+        let runtime = tokio::runtime::Handle::current();
+        move |manifest| runtime.block_on(state.quiesce_plugin(&manifest.id, false))
+    }
+
+    async fn quiesce_plugin(
+        self: &Arc<Self>,
+        plugin_id: &str,
+        uninstall: bool,
+    ) -> Result<PluginLifecycleGuard, String> {
+        // Lock ordering is installer file lock -> host activation lock. Stop never acquires the file lock.
+        let barrier = self.plugin_host.pause_lifecycle().await;
+        if uninstall {
+            let dependents = self
+                .storage
+                .load_connections()
+                .await?
+                .into_iter()
+                .filter(|connection| {
+                    connection.db_type == DatabaseType::Plugin && connection.plugin_id.as_deref() == Some(plugin_id)
+                })
+                .map(|connection| connection.name)
+                .collect::<Vec<_>>();
+            if !dependents.is_empty() {
+                return Err(format!(
+                    "Cannot uninstall plugin '{plugin_id}' while these connections still use it: {}",
+                    dependents.join(", ")
+                ));
+            }
+        }
+        let previous = self.plugins.find_plugin(plugin_id)?;
+        self.remove_plugin_connection_pools(plugin_id).await;
+        if let Some(plugin) = previous {
+            for driver in &plugin.manifest.drivers {
+                self.remove_external_driver_pools(driver.database_type.as_deref().unwrap_or(&driver.id)).await;
+            }
+        }
+        barrier.stop(plugin_id).await?;
+        // A connect already in flight may have published an old handle during the first drain.
+        self.remove_plugin_connection_pools(plugin_id).await;
+        Ok(barrier)
+    }
+
+    pub async fn install_plugin_package_bytes(
+        self: &Arc<Self>,
+        bytes: Vec<u8>,
+        policy: PluginInstallPolicy,
+    ) -> Result<PluginInstallResult, String> {
+        let installer = self.plugin_installer()?;
+        let barrier = self.plugin_install_barrier();
+        tokio::task::spawn_blocking(move || installer.install_bytes_before_activate(&bytes, policy, barrier))
+            .await
+            .map_err(|error| error.to_string())?
+    }
+
+    pub async fn install_plugin_package_file(
+        self: &Arc<Self>,
+        path: PathBuf,
+        policy: PluginInstallPolicy,
+    ) -> Result<PluginInstallResult, String> {
+        let installer = self.plugin_installer()?;
+        let barrier = self.plugin_install_barrier();
+        tokio::task::spawn_blocking(move || installer.install_file_before_activate(&path, policy, barrier))
+            .await
+            .map_err(|error| error.to_string())?
+    }
+
+    pub async fn install_plugin_from_marketplace(
+        self: &Arc<Self>,
+        request: PluginMarketplaceInstallRequest,
+    ) -> Result<PluginInstallResult, String> {
+        PluginMarketplace::new(self.plugins.root_dir().to_path_buf(), self.plugins.app_version().to_string())?
+            .install_before_activate(request, self.plugin_install_barrier())
+            .await
+    }
+
+    pub async fn rollback_plugin_package(self: &Arc<Self>, plugin_id: String) -> Result<PluginRollbackResult, String> {
+        let installer = self.plugin_installer()?;
+        let barrier = self.plugin_install_barrier();
+        tokio::task::spawn_blocking(move || installer.rollback_before_activate(&plugin_id, barrier))
+            .await
+            .map_err(|error| error.to_string())?
+    }
+
+    pub async fn uninstall_plugin_package(self: &Arc<Self>, plugin_id: String) -> Result<(), String> {
+        let installer = self.plugin_installer()?;
+        let state = self.clone();
+        let runtime = tokio::runtime::Handle::current();
+        tokio::task::spawn_blocking(move || {
+            installer.uninstall_before_remove(&plugin_id, |id| runtime.block_on(state.quiesce_plugin(id, true)))
+        })
+        .await
+        .map_err(|error| error.to_string())?
+    }
+}
diff --git a/crates/dbx-core/src/plugins/download_leases.rs b/crates/dbx-core/src/plugins/download_leases.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f7846e69739c6d38396706f48ab450c3937b9022
--- /dev/null
+++ b/crates/dbx-core/src/plugins/download_leases.rs
@@ -0,0 +1,204 @@
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+use serde_json::Value;
+
+pub(super) const DOWNLOAD_LEASE_CAPABILITY: &str = "filesystem.download-temp-v1";
+pub(super) const DOWNLOAD_LEASE_ID: &str = "hostDownloadLeaseId";
+pub(super) const DOWNLOAD_LEASE_DIRECTORY: &str = "downloadTemporaryDirectory";
+const MAX_LEASES: usize = 256;
+
+struct DownloadLease {
+    directory: PathBuf,
+    identity: same_file::Handle,
+    provider: String,
+    connection: String,
+}
+
+impl DownloadLease {
+    fn create(destination: &Path, provider: String, connection: String) -> Result<Self, String> {
+        if !destination.is_absolute() || destination.file_name().is_none() {
+            return Err("Download destination must be an absolute file path".into());
+        }
+        let parent = destination
+            .parent()
+            .ok_or("Missing download parent")?
+            .canonicalize()
+            .map_err(|_| "Cannot resolve download parent")?;
+        let mut builder = tempfile::Builder::new();
+        builder.prefix(".dbx-download-lease-");
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            builder.permissions(std::fs::Permissions::from_mode(0o700));
+        }
+        let directory = builder.tempdir_in(parent).map_err(|_| "Cannot create download temporary directory")?;
+        let identity =
+            same_file::Handle::from_path(directory.path()).map_err(|_| "Cannot identify download directory")?;
+        // Cleanup is explicit: dropping a session or a replaced path is not proof its writer exited.
+        Ok(Self { directory: directory.keep(), identity, provider, connection })
+    }
+
+    fn cleanup(&self) -> Result<(), String> {
+        let metadata = std::fs::symlink_metadata(&self.directory).map_err(|_| "Download directory disappeared")?;
+        if !metadata.is_dir()
+            || metadata.file_type().is_symlink()
+            || same_file::Handle::from_path(&self.directory).map_err(|_| "Cannot identify download directory")?
+                != self.identity
+        {
+            return Err("Download directory identity changed; refusing cleanup".into());
+        }
+        std::fs::remove_dir_all(&self.directory).map_err(|_| "Download temporary cleanup failed".into())
+    }
+}
+
+#[derive(Default)]
+pub(super) struct DownloadLeases {
+    leases: HashMap<String, DownloadLease>,
+    requests: HashMap<u64, String>,
+}
+
+impl DownloadLeases {
+    pub fn prepare(&mut self, params: &mut Value) -> Result<(), String> {
+        if self.leases.len() >= MAX_LEASES {
+            return Err("Too many pending download temporary directories".into());
+        }
+        let field = |name| {
+            params
+                .get(name)
+                .and_then(Value::as_str)
+                .map(str::to_owned)
+                .ok_or_else(|| format!("Missing download {name}"))
+        };
+        let lease =
+            DownloadLease::create(Path::new(&field("localPath")?), field("providerId")?, field("connectionId")?)?;
+        let id = uuid::Uuid::new_v4().to_string();
+        params[DOWNLOAD_LEASE_ID] = Value::String(id.clone());
+        params[DOWNLOAD_LEASE_DIRECTORY] = Value::String(lease.directory.to_string_lossy().into_owned());
+        self.leases.insert(id, lease);
+        Ok(())
+    }
+
+    pub fn bind_request(&mut self, request: u64, params: &Value) {
+        if let Some(id) = params[DOWNLOAD_LEASE_ID].as_str().filter(|id| self.leases.contains_key(*id)) {
+            self.requests.insert(request, id.to_string());
+        }
+    }
+
+    pub fn response(&mut self, request: u64, value: &Value) {
+        if let Some(id) = self.requests.remove(&request) {
+            if value.get("error").is_some() {
+                // A wire rejection is terminal. A host timeout never enters this path.
+                self.release(&id);
+            } else if let Some(snapshot) = value.get("result") {
+                if snapshot[DOWNLOAD_LEASE_ID].as_str() == Some(&id) {
+                    self.snapshot(snapshot);
+                }
+            }
+        }
+    }
+
+    pub fn snapshot(&mut self, snapshot: &Value) {
+        let Some(id) = snapshot[DOWNLOAD_LEASE_ID].as_str() else { return };
+        let Some(lease) = self.leases.get(id) else { return };
+        if snapshot["providerId"].as_str() == Some(&lease.provider)
+            && snapshot["connectionId"].as_str() == Some(&lease.connection)
+            && matches!(snapshot["state"].as_str(), Some("completed" | "failed" | "cancelled"))
+        {
+            self.release(id);
+        }
+    }
+
+    fn release(&mut self, id: &str) {
+        if let Some(lease) = self.leases.get(id) {
+            match lease.cleanup() {
+                Ok(()) => {
+                    self.leases.remove(id);
+                }
+                Err(error) => log::warn!("Plugin download lease cleanup: {error}"),
+            }
+        }
+    }
+
+    pub fn process_exited(&mut self) {
+        self.requests.clear();
+        for id in self.leases.keys().cloned().collect::<Vec<_>>() {
+            self.release(&id);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn prepare(root: &Path) -> (DownloadLeases, Value, PathBuf) {
+        let mut leases = DownloadLeases::default();
+        let mut params =
+            json!({"localPath": root.join("original"), "providerId": "files", "connectionId": "connection"});
+        leases.prepare(&mut params).unwrap();
+        let directory = PathBuf::from(params[DOWNLOAD_LEASE_DIRECTORY].as_str().unwrap());
+        std::fs::write(directory.join("partial"), b"partial").unwrap();
+        (leases, params, directory)
+    }
+
+    #[test]
+    fn only_matching_terminal_snapshot_releases_owned_directory() {
+        let root = tempfile::tempdir().unwrap();
+        std::fs::write(root.path().join("original"), b"original").unwrap();
+        let (mut leases, mut params, directory) = prepare(root.path());
+        params["state"] = json!("running");
+        leases.snapshot(&params);
+        assert!(directory.exists());
+        params["state"] = json!("completed");
+        params["connectionId"] = json!("another");
+        leases.snapshot(&params);
+        assert!(directory.exists());
+        params["connectionId"] = json!("connection");
+        leases.snapshot(&params);
+        assert!(!directory.exists());
+        assert_eq!(std::fs::read(root.path().join("original")).unwrap(), b"original");
+    }
+
+    #[test]
+    fn late_wire_rejection_and_process_exit_reclaim_leases() {
+        let root = tempfile::tempdir().unwrap();
+        let (mut leases, params, directory) = prepare(root.path());
+        leases.bind_request(5, &params);
+        assert!(directory.exists()); // No response, including a local timeout, is not a cleanup signal.
+        leases.response(5, &json!({"error": {"code": -32602}}));
+        assert!(!directory.exists());
+        let (mut leases, _, directory) = prepare(root.path());
+        leases.process_exited();
+        assert!(!directory.exists());
+    }
+
+    #[test]
+    fn replaced_directory_is_not_deleted() {
+        let root = tempfile::tempdir().unwrap();
+        let (mut leases, _, directory) = prepare(root.path());
+        let moved = root.path().join("moved");
+        std::fs::rename(&directory, &moved).unwrap();
+        std::fs::create_dir(&directory).unwrap();
+        std::fs::write(directory.join("unowned"), b"keep").unwrap();
+        leases.process_exited();
+        assert_eq!(std::fs::read(directory.join("unowned")).unwrap(), b"keep");
+        assert!(moved.join("partial").exists());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn directory_permissions_and_symlink_replacement_are_safe() {
+        use std::os::unix::fs::{symlink, PermissionsExt};
+        let root = tempfile::tempdir().unwrap();
+        let (mut leases, _, directory) = prepare(root.path());
+        assert_eq!(std::fs::metadata(&directory).unwrap().permissions().mode() & 0o777, 0o700);
+        let moved = root.path().join("moved");
+        std::fs::rename(&directory, &moved).unwrap();
+        symlink(&moved, &directory).unwrap();
+        leases.process_exited();
+        assert!(directory.symlink_metadata().unwrap().file_type().is_symlink());
+        assert!(moved.join("partial").exists());
+    }
+}
