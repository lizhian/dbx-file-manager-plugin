  "localizations": {
    "zh-CN": {
      "name": "OpenDAL 文件管理器",
      "description": "OpenDAL 文件管理：通用服务配置、目录浏览、上传下载、图片预览与文本编辑。兼容官方 Host API 1.0。",
      "contributions": {
        "io.github.lizhian.file-manager.ftp": {
          "label": "FTP",
          "description": "警告：FTP 以明文传输凭据和文件数据，仅限可信网络。",
          "fields": {
            "display_name": {
              "label": "连接名称"
            },
            "host": {
              "label": "主机"
            },
            "port": {
              "label": "端口"
            },
            "username": {
              "label": "用户名"
            },
            "password": {
              "label": "密码"
            },
            "root": {
              "label": "远程根目录"
            }
          }
        },
        "io.github.lizhian.file-manager.sftp": {
          "label": "SFTP",
          "description": "仅支持 Unix，需要本地 OpenSSH。Windows SFTP 不在验收范围内。认证条件字段由后端校验。",
          "fields": {
            "display_name": {
              "label": "连接名称"
            },
            "host": {
              "label": "主机"
            },
            "port": {
              "label": "端口"
            },
            "username": {
              "label": "用户名",
              "description": "可由 SSH 配置提供，后端按认证方式校验。"
            },
            "root": {
              "label": "远程根目录"
            },
            "authentication": {
              "label": "认证方式",
              "options": {
                "ssh_config": "SSH 配置",
                "ssh_agent": "SSH 代理",
                "private_key": "私钥"
              }
            },
            "private_key": {
              "label": "私钥文件",
              "description": "填写 Sidecar 所在机器上 OpenSSH 私钥文件的绝对路径，而非私钥内容；仅私钥认证时必填。"
            }
          }
        },
        "io.github.lizhian.file-manager.s3": {
          "label": "S3",
          "description": "连接 S3 或兼容端点。凭据由宿主 Secret Store 保存。",
