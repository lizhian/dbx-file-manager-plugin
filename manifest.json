{
  "$schema": "./tests/schema/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.github.lizhian.file-manager",
  "name": "OpenDAL File Manager",
  "version": "0.2.0",
  "publisher": "lizhian",
  "description": "OpenDAL 文件管理：通用服务配置、目录浏览、文件传输、图片预览和文本编辑。",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.5.68",
    "host_api": ">=1.0.0, <2.0.0"
  },
  "permissions": [
    "host.events"
  ],
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-plugin-dbx-file-manager-plugin",
      "transport": "stdio-framed",
      "protocol_versions": [
        1
      ]
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.github.lizhian.file-manager.ftp",
      "label": "FTP",
      "icon": "assets/plugin.svg",
      "database_type": "ftp",
      "description": "Warning: FTP sends credentials and file data in plaintext. Use only on trusted networks.",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ],
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "FTP"
        },
        {
          "key": "host",
          "label": "Host",
          "type": "text",
          "binding": "host",
          "required": true
        },
        {
          "key": "port",
          "label": "Port",
          "type": "number",
          "binding": "port",
          "required": true,
          "default": 21
        },
        {
          "key": "username",
          "label": "Username",
          "type": "text",
          "binding": "username",
          "required": true
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "binding": "secret",
          "required": false
        },
        {
          "key": "root",
          "label": "Remote root",
          "type": "text",
          "binding": "secret",
          "required": true,
          "default": "/"
        }
      ],
      "workbench": "io.github.lizhian.file-manager.main"
    },
    {
      "type": "connection-provider",
      "id": "io.github.lizhian.file-manager.sftp",
      "label": "SFTP",
      "icon": "assets/plugin.svg",
      "database_type": "sftp",
      "description": "Unix only: SFTP requires local OpenSSH. Windows SFTP acceptance is out of scope. Authentication-specific fields are validated by the backend.",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ],
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "SFTP"
        },
        {
          "key": "host",
          "label": "Host",
          "type": "text",
          "binding": "host",
          "required": true
        },
        {
          "key": "port",
          "label": "Port",
          "type": "number",
          "binding": "port",
          "required": true,
          "default": 22
        },
        {
          "key": "username",
          "label": "Username",
          "type": "text",
          "binding": "username",
          "required": false,
          "description": "May be supplied by SSH config; validated by the backend for the selected authentication mode."
        },
        {
          "key": "root",
          "label": "Remote root",
          "type": "text",
          "binding": "secret",
          "required": true,
          "default": "/"
        },
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "binding": "secret",
          "required": true,
          "default": "ssh_config",
          "options": [
            {
              "label": "SSH config",
              "value": "ssh_config"
            },
            {
              "label": "SSH agent",
              "value": "ssh_agent"
            },
            {
              "label": "Private key",
              "value": "private_key"
            }
          ]
        },
        {
          "key": "private_key",
          "label": "Private key file",
          "type": "password",
          "binding": "secret",
          "required": false,
          "description": "Absolute local OpenSSH private-key file path on the sidecar machine, not key content. Required for private_key authentication only."
        }
      ],
      "workbench": "io.github.lizhian.file-manager.main"
    },
    {
      "type": "connection-provider",
      "id": "io.github.lizhian.file-manager.s3",
      "label": "S3",
      "icon": "assets/plugin.svg",
      "database_type": "s3",
      "description": "S3 or an S3-compatible endpoint. Credentials are stored by the host Secret Store.",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ],
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "S3"
        },
        {
          "key": "root",
          "label": "Remote root",
          "type": "text",
          "binding": "secret",
          "required": true,
          "default": "/"
        },
        {
          "key": "endpoint",
          "label": "Endpoint",
          "type": "text",
          "binding": "secret",
          "required": true,
          "description": "Explicit HTTP(S) S3 endpoint. Do not embed credentials."
        },
        {
          "key": "region",
          "label": "Region",
          "type": "text",
          "binding": "secret",
          "required": true,
          "default": "us-east-1"
        },
        {
          "key": "bucket",
          "label": "Bucket",
          "type": "text",
          "binding": "secret",
          "required": true
        },
        {
          "key": "path_style",
          "label": "Path-style addressing",
          "type": "select",
          "binding": "secret",
          "required": false,
          "default": "false",
          "options": [
            {
              "label": "是",
              "value": "true"
            },
            {
              "label": "否",
              "value": "false"
            }
          ]
        },
        {
          "key": "access_key",
          "label": "Access key",
          "type": "password",
          "binding": "secret",
          "required": true
        },
        {
          "key": "secret_key",
          "label": "Secret key",
          "type": "password",
          "binding": "secret",
          "required": true
        },
        {
          "key": "session_token",
          "label": "Session token",
          "type": "password",
          "binding": "secret",
          "required": false
        }
      ],
      "workbench": "io.github.lizhian.file-manager.main"
    },
    {
      "type": "connection-provider",
      "id": "io.github.lizhian.file-manager.webdav",
      "label": "WebDAV",
      "icon": "assets/plugin.svg",
      "database_type": "webdav",
      "description": "WebDAV Basic/Bearer authentication. Use HTTPS outside local fixtures. Authentication-specific fields are validated by the backend.",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ],
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "WebDAV"
        },
        {
          "key": "root",
          "label": "Remote root",
          "type": "text",
          "binding": "secret",
          "required": true,
          "default": "/"
        },
        {
          "key": "endpoint",
          "label": "Endpoint",
          "type": "text",
          "binding": "secret",
          "required": true,
          "description": "HTTP(S) URL without embedded credentials."
        },
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "binding": "secret",
          "required": true,
          "default": "basic",
          "options": [
            {
              "label": "Basic",
              "value": "basic"
            },
            {
              "label": "Bearer token",
              "value": "bearer"
            }
          ]
        },
        {
          "key": "username",
          "label": "Username",
          "type": "text",
          "binding": "username",
          "required": false,
          "description": "Basic authentication only; validated by the backend."
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "binding": "secret",
          "required": false,
          "description": "Basic authentication only; validated by the backend."
        },
        {
          "key": "bearer_token",
          "label": "Bearer token",
          "type": "password",
          "binding": "secret",
          "required": false,
          "description": "Required by the backend for Bearer authentication only."
        }
      ],
      "workbench": "io.github.lizhian.file-manager.main"
    },
    {
      "type": "connection-provider",
      "id": "io.github.lizhian.file-manager.webhdfs",
      "label": "WebHDFS",
      "icon": "assets/plugin.svg",
      "database_type": "webhdfs",
      "description": "WebHDFS with simple user or a delegation token. Kerberos and HDFS HA are out of scope.",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ],
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "WebHDFS"
        },
        {
          "key": "root",
          "label": "Remote root",
          "type": "text",
          "binding": "secret",
          "required": true,
          "default": "/"
        },
        {
          "key": "endpoint",
          "label": "Endpoint",
          "type": "text",
          "binding": "secret",
          "required": true,
          "description": "HTTP(S) NameNode URL without embedded credentials or tokens."
        },
        {
          "key": "use_delegation_token",
          "label": "Use delegation token",
          "type": "select",
          "binding": "secret",
          "required": false,
          "default": "false",
          "options": [
            {
              "label": "是",
              "value": "true"
            },
            {
              "label": "否",
              "value": "false"
            }
          ]
        },
        {
          "key": "simple_user",
          "label": "Simple user",
          "type": "text",
          "binding": "secret",
          "required": false,
          "description": "Used when delegation tokens are disabled; validated by the backend."
        },
        {
          "key": "delegation_token",
          "label": "Delegation token",
          "type": "password",
          "binding": "secret",
          "required": false,
          "description": "Required by the backend when use_delegation_token is enabled."
        }
      ],
      "workbench": "io.github.lizhian.file-manager.main"
    },
    {
      "type": "connection-provider",
      "id": "io.github.lizhian.file-manager.hdfs-native",
      "label": "HDFS Native",
      "icon": "assets/plugin.svg",
      "database_type": "hdfs-native",
      "description": "The Hadoop configuration directory is a local path on the machine running the sidecar, not a remote HDFS path. Kerberos and HDFS HA are out of scope.",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ],
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "HDFS Native"
        },
        {
          "key": "root",
          "label": "Remote root",
          "type": "text",
          "binding": "secret",
          "required": true,
          "default": "/"
        },
        {
          "key": "name_node_uri",
          "label": "NameNode URI",
          "type": "text",
          "binding": "secret",
          "required": true,
          "description": "An hdfs:// endpoint, distinct from the host navigation URI hdfs-native:/."
        },
        {
          "key": "hadoop_config_directory",
          "label": "Local Hadoop configuration directory",
          "type": "text",
          "binding": "secret",
          "required": true,
          "description": "Accessible absolute local directory containing core-site.xml or hdfs-site.xml, read by the sidecar. Never paste credentials here."
        }
      ],
      "workbench": "io.github.lizhian.file-manager.main"
    },
    {
      "type": "workbench",
      "id": "io.github.lizhian.file-manager.main",
      "label": "文件管理"
    },
